@using Microsoft.AspNetCore.Components.Authorization
@using RestauranteTuristicoApp.Models
@using RestauranteTuristicoApp.Services
@inject MenuService MenuService
@inject ComponentScanner Scanner

<MudNavMenu Class="pa-2" Rounded="true" Color="Color.Primary" Margin="Margin.Normal">

    @if (menuItems == null)
    {
        <!-- Indicador de carga mientras consulta la BD -->
        <div class="d-flex align-center justify-center pa-4">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
            <MudText Class="ml-2" Typo="Typo.caption">Cargando menú...</MudText>
        </div>
    }
    else
    {
        @foreach (var item in menuItems)
        {
            <!-- 1. Validación física con Reflection -->
            @if (Scanner.ExisteComponente(item.NombreComponente))
            {
                <!-- 2. Validación de Autenticación / Roles -->
                @if (string.IsNullOrEmpty(item.RolRequerido))
                {
                    <!-- Opción Pública (Visibles para todos) -->
                    <MudNavLink Href="@item.Ruta" Match="NavLinkMatch.Prefix" Icon="@ObtenerIconoMaterial(item.Icono)">
                        @item.NombrePantalla
                    </MudNavLink>
                }
                else
                {
                    <!-- Opción Protegida por Rol -->
                    <AuthorizeView Roles="@item.RolRequerido">
                        <Authorized>
                            <MudNavLink Href="@item.Ruta" Match="NavLinkMatch.Prefix" Icon="@ObtenerIconoMaterial(item.Icono)">
                                @item.NombrePantalla
                            </MudNavLink>
                        </Authorized>
                    </AuthorizeView>
                }
            }
        }
    }

    <MudDivider Class="my-3" />

    <!-- Botón Dinámico de Inicio/Cierre de Sesión -->
    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="logout" Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error">
                Cerrar Sesión
            </MudNavLink>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="login" Icon="@Icons.Material.Filled.Login" IconColor="Color.Primary">
                Iniciar Sesión
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>

</MudNavMenu>

@code {
    private List<MenuItem>? menuItems;

    protected override async Task OnInitializedAsync()
    {
        // Cargar menú desde PostgreSQL al iniciar el componente
        menuItems = await MenuService.ObtenerMenuItemsAsync();
    }

    // Helper para mapear texto de icono de BD a íconos vectoriales de MudBlazor
    private string ObtenerIconoMaterial(string iconoBD) => iconoBD switch
    {
        "Home" => Icons.Material.Filled.Home,
        "Menu" => Icons.Material.Filled.RestaurantMenu,
        "Cliente" => Icons.Material.Filled.EventAvailable,
        "Empleado" => Icons.Material.Filled.TableBar,
        "Administrador" => Icons.Material.Filled.AdminPanelSettings,
        _ => Icons.Material.Filled.BookmarkBorder
    };
}