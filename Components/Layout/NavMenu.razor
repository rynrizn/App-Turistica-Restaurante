@using Microsoft.AspNetCore.Components.Authorization
@using RestauranteTuristicoApp.Models
@using RestauranteTuristicoApp.Services
@inject MenuService MenuService
@inject ComponentScanner Scanner

<nav class="sabor-sidebar-nav">
    <ul class="nav flex-column">
        @if (menuItems == null)
        {
            <li class="nav-item pa-4 text-center text-muted my-3">
                <div class="spinner-border spinner-border-sm text-danger me-2" role="status"></div>
                <span>Cargando menú...</span>
            </li>
        }
        else
        {
            @foreach (var item in menuItems)
            {
                @if (Scanner.ExisteComponente(item.NombreComponente))
                {
                    @if (string.IsNullOrEmpty(item.RolRequerido))
                    {
                        <li class="nav-item">
                            <NavLink class="nav-link" href="@item.Ruta" Match="@(item.Ruta == "" || item.Ruta == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)" @onclick="CerrarSidebarMovil">
                                <i class="bi @ObtenerIconoBootstrap(item.Icono) me-3 fs-5"></i>
                                <span>@item.NombrePantalla</span>
                            </NavLink>
                        </li>
                    }
                    else
                    {
                        <AuthorizeView Roles="@item.RolRequerido">
                            <Authorized>
                                <li class="nav-item">
                                    <NavLink class="nav-link" href="@item.Ruta" Match="@(item.Ruta == "" || item.Ruta == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)" @onclick="CerrarSidebarMovil">
                                        <i class="bi @ObtenerIconoBootstrap(item.Icono) me-3 fs-5"></i>
                                        <span>@item.NombrePantalla</span>
                                    </NavLink>
                                </li>
                            </Authorized>
                        </AuthorizeView>
                    }
                }
            }
        }
    </ul>
</nav>

@code {
    private List<MenuItem>? menuItems;

    protected override async Task OnInitializedAsync()
    {
        menuItems = await MenuService.ObtenerMenuItemsAsync();
    }

    private string ObtenerIconoBootstrap(string iconoBD) => iconoBD switch
    {
        "Home" => "bi-house-fill",
        "Menu" => "bi-book-half",
        "Cliente" => "bi-calendar-check",
        "Empleado" => "bi-table",
        "Administrador" => "bi-shield-lock-fill",
        _ => "bi-bookmark"
    };

    private async Task CerrarSidebarMovil()
    {
        await InvokeAsync(StateHasChanged);
    }
}