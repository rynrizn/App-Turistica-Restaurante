@using Microsoft.AspNetCore.Components.Authorization

<MudNavMenu Class="pa-2" Rounded="true" Color="Color.Primary" Margin="Margin.Normal">

    <!-- SECCIÓN PÚBLICA / INICIO -->
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
        Inicio
    </MudNavLink>
    
    <MudNavLink Href="menu" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.RestaurantMenu">
        Menú Gastronómico
    </MudNavLink>

    <!-- VISTAS DE PRUEBA (Bootstrap por defecto) -->
    <MudNavGroup Title="Pruebas Técnicas" Icon="@Icons.Material.Filled.Science" Expanded="false">
        <MudNavLink Href="counter" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AddCircleOutline">
            Counter
        </MudNavLink>
        <MudNavLink Href="weather" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.WbSunny">
            Weather
        </MudNavLink>
    </MudNavGroup>

    <MudDivider Class="my-3" />

    <!-- VALIDACIÓN DE AUTENTICACIÓN -->
    <AuthorizeView>
        <!-- CONTENIDO SI EL USUARIO ESTÁ AUTENTICADO -->
        <Authorized>
            <!-- Menú del Cliente -->
            <MudText Typo="Typo.caption" Class="px-4 mt-2 font-weight-bold" Style="color: var(--mud-palette-text-disabled); text-transform: uppercase;">
                Mi Cuenta
            </MudText>
            
            <MudNavLink Href="reservas/nueva" Icon="@Icons.Material.Filled.EventAvailable">
                Reservar Mesa
            </MudNavLink>
            <MudNavLink Href="mis-reservas" Icon="@Icons.Material.Filled.BookmarkBorder">
                Mis Reservas
            </MudNavLink>

            <!-- Menú para Rol: Empleado o Administrador -->
            <AuthorizeView Roles="Empleado, Administrador" Context="staffContext">
                <Authorized>
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.caption" Class="px-4 mt-2 font-weight-bold" Style="color: var(--mud-palette-text-disabled); text-transform: uppercase;">
                        Módulo Operativo
                    </MudText>
                    
                    <MudNavGroup Title="Gestión Sala" Icon="@Icons.Material.Filled.TableBar" Expanded="false">
                        <MudNavLink Href="gestion/mesas" Icon="@Icons.Material.Filled.TableRestaurant">
                            Estado de Mesas
                        </MudNavLink>
                        <MudNavLink Href="gestion/pedidos" Icon="@Icons.Material.Filled.Receipt">
                            Atender Pedidos
                        </MudNavLink>
                    </MudNavGroup>
                </Authorized>
            </AuthorizeView>

            <!-- Menú Exclusivo para Rol: Administrador -->
            <AuthorizeView Roles="Administrador" Context="adminContext">
                <Authorized>
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.caption" Class="px-4 mt-2 font-weight-bold" Style="color: var(--mud-palette-text-disabled); text-transform: uppercase;">
                        Administración
                    </MudText>

                    <MudNavGroup Title="Panel Admin" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="true">
                        <MudNavLink Href="admin/dashboard" Icon="@Icons.Material.Filled.Dashboard">
                            Dashboard y Reportes
                        </MudNavLink>
                        <MudNavLink Href="admin/productos" Icon="@Icons.Material.Filled.Fastfood">
                            Gestionar Menú (CRUD)
                        </MudNavLink>
                        <MudNavLink Href="admin/usuarios" Icon="@Icons.Material.Filled.People">
                            Gestionar Usuarios
                        </MudNavLink>
                    </MudNavGroup>
                </Authorized>
            </AuthorizeView>

            <MudDivider Class="my-3" />
            
            <!-- Botón / Enlace para Cerrar Sesión -->
            <MudNavLink Href="logout" Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error">
                Cerrar Sesión
            </MudNavLink>
        </Authorized>

        <!-- CONTENIDO SI EL USUARIO NO HA INICIADO SESIÓN (ANÓNIMO) -->
        <NotAuthorized>
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.caption" Class="px-4 mt-2 font-weight-bold" Style="color: var(--mud-palette-text-disabled); text-transform: uppercase;">
                Acceso
            </MudText>

            <MudNavLink Href="login" Icon="@Icons.Material.Filled.Login" IconColor="Color.Primary">
                Iniciar Sesión
            </MudNavLink>
            <MudNavLink Href="registro" Icon="@Icons.Material.Filled.PersonAdd">
                Registrarse
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>

</MudNavMenu>