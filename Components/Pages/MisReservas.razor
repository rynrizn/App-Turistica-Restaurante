@page "/mis-reservas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Cliente")]
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using RestauranteTuristicoApp.Models
@using RestauranteTuristicoApp.Services
@inject ReservaService ReservaService
@inject AuthenticationStateProvider AuthStateProvider
@inject ToastService Toast
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Mis Reservas | Sabor & Tradición</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-5 gap-3">
    <div>
        <h1 class="font-playfair fw-bold mb-1" style="color: var(--sabor-burgundy);">
            Historial de Reservas
        </h1>
        <p class="text-muted mb-0">
            Consulte y gestione todas sus reservaciones de mesa y cava.
        </p>
    </div>
    <button type="button" class="btn btn-sabor-burgundy px-4 py-2" @onclick="@(() => Navigation.NavigateTo("reservas/nueva"))">
        <i class="bi bi-plus-lg me-2"></i>NUEVA RESERVA
    </button>
</div>

@if (_cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-danger" role="status"></div>
        <p class="text-muted mt-2">Cargando sus reservas...</p>
    </div>
}
else if (!_reservas.Any())
{
    <div class="alert alert-info py-4 text-center">
        <i class="bi bi-calendar-x fs-2 d-block mb-2"></i>
        <h5 class="fw-bold">Aún no tiene reservas registradas</h5>
        <p class="mb-0">¡Le invitamos a realizar su primera reservación en nuestra carta gastronómica!</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var res in _reservas)
        {
            var mesaNum = res.ReservaMesas.FirstOrDefault()?.Mesa?.NumeroMesa.ToString() ?? "N/A";
            <div class="col-12 col-md-6">
                <div class="card sabor-card h-100 shadow-sm border-0 border-start border-4" style="border-left-color: var(--sabor-burgundy) !important;">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="font-playfair fw-bold mb-1">Mesa #@mesaNum</h5>
                                <small class="text-muted">Código: <strong>@res.CodigoReserva</strong></small>
                            </div>
                            <span class="badge @GetBadgeClass(res.Estado) px-3 py-2">
                                @res.Estado
                            </span>
                        </div>

                        <hr class="my-2" />

                        <div class="my-2 flex-grow-1">
                            <p class="mb-1 small">
                                <i class="bi bi-calendar-event me-2 text-danger"></i>
                                <strong>@res.FechaReserva.ToString("dd/MM/yyyy")</strong> a las <strong>@res.HoraReserva.ToString("hh\\:mm")</strong>
                            </p>
                            <p class="mb-2 small">
                                <i class="bi bi-people me-2 text-danger"></i>
                                @res.CantidadPersonas comensales
                            </p>
                            @if (!string.IsNullOrWhiteSpace(res.Observaciones))
                            {
                                <p class="text-muted small fst-italic mb-2">
                                    Nota: @res.Observaciones
                                </p>
                            }
                            @if (res.DetalleReservas.Any())
                            {
                                <div class="p-2 rounded bg-light border border-dashed small mt-2">
                                    <strong class="d-block mb-1" style="color: var(--sabor-burgundy);">Pre-orden de Platillos:</strong>
                                    @foreach (var det in res.DetalleReservas)
                                    {
                                        <div class="text-muted">
                                            • @det.Cantidad x @det.Producto.Nombre (Bs. @((det.Cantidad * det.PrecioUnitario).ToString("N2")))
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        @if (res.Estado == "Pendiente" || res.Estado == "Confirmada")
                        {
                            <div class="d-flex justify-content-end mt-3 pt-2 border-top">
                                <button type="button" class="btn btn-outline-danger btn-sm px-3"
                                        @onclick="() => Cancelar(res)">
                                    <i class="bi bi-x-circle me-1"></i>Cancelar
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Reserva> _reservas = new();
    private bool _cargando = true;
    private int _userId;

    protected override async Task OnInitializedAsync()
    {
        await CargarReservas();
    }

    private async Task CargarReservas()
    {
        _cargando = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var idClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(idClaim, out int uid))
        {
            _userId = uid;
            _reservas = await ReservaService.GetReservasByUsuarioAsync(_userId);
        }
        _cargando = false;
    }

    private async Task Cancelar(Reserva res)
    {
        var resultado = await ReservaService.CancelarReservaAsync(res.Id, _userId);
        if (resultado.exito)
        {
            Toast.ShowWarning(resultado.mensaje);
            await CargarReservas();
        }
        else
        {
            Toast.ShowError(resultado.mensaje);
        }
    }

    private string GetBadgeClass(string estado) => estado switch
    {
        "Confirmada" => "bg-success",
        "Completada" => "bg-info",
        "Cancelada" => "bg-danger",
        "Pendiente" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}
