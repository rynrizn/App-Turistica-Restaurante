@page "/"
@using RestauranteTuristicoApp.Models
@using RestauranteTuristicoApp.Services
@inject ToastService Toast
@inject NavigationManager Navigation
@inject ProductoService ProductoService
@inject ResenaService ResenaService

<PageTitle>Sabor & Tradición | Menú & Cava Tarijeña</PageTitle>

<!-- SECCIÓN HERO / PRESENTACIÓN -->
<section class="p-4 p-md-5 mb-5 rounded-4" 
         style="background: linear-gradient(135deg, rgba(97, 0, 0, 0.92) 0%, rgba(44, 44, 44, 0.94) 100%), url('https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat; color: white; box-shadow: 0 16px 40px rgba(97,0,0,0.25);">
    <div class="row align-items-center">
        <div class="col-12 col-md-8">
            <span class="badge sabor-chip-gold px-3 py-2 mb-3 d-inline-flex align-items-center">
                <i class="bi bi-cup-hot-fill me-2"></i> ALTA GASTRONOMÍA & VINOS DE ALTURA
            </span>
            <h1 class="display-5 mb-3 font-playfair fw-bold" style="line-height: 1.15;">
                El Sabor de Tarija,<br />
                <span style="color: #fed65b; font-style: italic;">Elevado en Cada Detalle.</span>
            </h1>
            <p class="mb-4 lead text-light" style="max-width: 600px; font-size: 1.1rem;">
                Un homenaje a la cocina chapaca patrimonial maridada con los mejores vinos Tannat del Valle de la Concepción. Disfrute como un auténtico sommelier.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <button type="button" class="btn btn-sabor-gold btn-lg px-4 py-2" @onclick="@(() => Navigation.NavigateTo("reservas"))">
                    <i class="bi bi-calendar-check me-2"></i>RESERVAR MESA
                </button>
                <button type="button" class="btn btn-outline-light btn-lg px-4 py-2 fw-semibold" @onclick="ScrollToMenu">
                    <i class="bi bi-book-half me-2"></i>VER CARTA DEL CHEF
                </button>
            </div>
        </div>
        <div class="col-12 col-md-4 d-none d-md-flex justify-content-end mt-4 mt-md-0">
            <div class="p-4 rounded-4 text-center" style="background: rgba(255,255,255,0.1); backdrop-filter: blur(10px); border: 1px solid rgba(254,214,91,0.4); max-width: 280px;">
                <h3 class="font-playfair fw-bold mb-0" style="color: #fed65b;">1,850 m</h3>
                <small class="text-white text-uppercase" style="letter-spacing: 1px;">Altitud de Nuestros Viñedos</small>
                <hr class="my-3" style="border-color: rgba(254,214,91,0.3);" />
                <h4 class="font-playfair fw-bold mb-0 text-white">4.9 / 5.0 ★</h4>
                <small class="text-light">Calificación de Críticos Culinarios</small>
            </div>
        </div>
    </div>
</section>

<!-- FILTROS DE CATEGORÍA -->
<section id="seccion-menu" class="mb-5">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
        <div>
            <h2 class="font-playfair fw-bold text-sabor-burgundy mb-1" style="color: var(--sabor-burgundy);">
                Carta Gastronómica
            </h2>
            <p class="text-muted small mb-0">Seleccione los platos ancestrales que conformarán su experiencia culinaria en su próxima reserva.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var cat in _categorias)
            {
                var isActive = _selectedCategory == cat;
                <button type="button"
                        class="btn btn-sm rounded-pill px-3 @(isActive ? "btn-sabor-burgundy" : "btn-outline-secondary")"
                        @onclick="() => SetCategory(cat)">
                    @cat
                </button>
            }
        </div>
    </div>

    <!-- BUSCADOR RÁPIDO -->
    <div class="row mb-4">
        <div class="col-12 col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control border-start-0" placeholder="Buscar por ingrediente, nombre o vino..."
                       @bind="_searchTerm" @bind:event="oninput" />
            </div>
        </div>
    </div>

    <!-- GRID DE PLATOS Y VINOS -->
    <div class="row g-4">
        @foreach (var plato in FilteredPlatos)
        {
            <div class="col-12 col-sm-6 col-md-4">
                <div class="card sabor-card h-100 shadow-sm">
                    <div class="sabor-image-container position-relative" style="height: 220px;">
                        <img src="@plato.ImagenUrl" alt="@plato.Nombre" class="w-100 h-100 object-fit-cover" />
                        <span class="badge position-absolute top-0 end-0 m-3 @(plato.Disponible == true ? "bg-success" : "bg-secondary")">
                            @(plato.Disponible == true ? "Disponible" : "Agotado")
                        </span>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-baseline mb-2">
                            <span class="badge bg-light text-dark border small">@(plato.Categoria?.Nombre ?? "Tradicional")</span>
                            <span class="fw-bold fs-5" style="color: var(--sabor-burgundy);">@plato.Precio.ToString("N2") Bs</span>
                        </div>
                        <h5 class="card-title font-playfair fw-bold mb-2">@plato.Nombre</h5>
                        <p class="card-text text-muted small flex-grow-1">@plato.Descripcion</p>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between align-items-center pb-3">
                        <button type="button" class="btn btn-sm btn-sabor-burgundy px-3"
                                @onclick="() => OnOrderDish(plato)" disabled="@(plato.Disponible != true)">
                            <i class="bi bi-plus-circle me-1"></i> Pre-ordenar
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-circle"
                                @onclick="() => OnLikeDish(plato)" title="Me gusta">
                            <i class="bi bi-heart"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- SECCIÓN DE RESEÑAS Y TESTIMONIOS -->
@if (_resenasPublicas.Any())
{
    <section class="mt-5">
        <div class="text-center mb-4">
            <span class="badge bg-light text-dark border px-3 py-2 mb-2">OPINIONES DE COMENSALES</span>
            <h3 class="fw-bold" style="color: var(--sabor-burgundy);">Experiencias en Sabor & Tradición</h3>
        </div>
        <div class="row g-4">
            @foreach (var resena in _resenasPublicas.Take(3))
            {
                <div class="col-12 col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-4" style="background-color: #ffffff;">
                        <div class="mb-2 text-warning">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= resena.Calificacion)
                                {
                                    <i class="bi bi-star-fill me-1"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star me-1 text-muted"></i>
                                }
                            }
                        </div>
                        <p class="card-text text-muted fst-italic flex-grow-1">
                            "@resena.Comentario"
                        </p>
                        <div class="d-flex align-items-center mt-3 pt-3 border-top">
                            <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; color: var(--sabor-burgundy);">
                                <i class="bi bi-person-fill fs-5"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">@(resena.Usuario?.NombreCompleto ?? "Comensal Sabor & Tradición")</h6>
                                <small class="text-muted">@resena.FechaResena.ToString("dd/MM/yyyy")</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

<!-- PIE / SECCIÓN DE INFORMACIÓN COLONIAL -->
<section class="mt-5 p-4 p-md-5 rounded-4 text-center bg-light border">
    <i class="bi bi-patch-check-fill fs-2 text-warning mb-2 d-inline-block"></i>
    <h3 class="font-playfair fw-bold mb-2" style="color: var(--sabor-burgundy);">
        Gastronomía Patrimonial Tarijeña
    </h3>
    <p class="text-muted mx-auto mb-0" style="max-width: 680px;">
        Todos nuestros ingredientes provienen de productores locales del Valle de La Concepción y San Lorenzo. Cocinamos con leña de molle y respetamos los tiempos de cocción de nuestras abuelas.
    </p>
</section>

@code {
    private string _searchTerm = "";
    private string _selectedCategory = "Todos";

    private List<Producto> _platos = new();
    private List<Resena> _resenasPublicas = new();
    private readonly List<string> _categorias = new() { "Todos" };

    protected override async Task OnInitializedAsync()
    {
        _platos = await ProductoService.GetProductosDisponiblesAsync();
        _resenasPublicas = await ResenaService.GetResenasPublicasAsync();
        var catList = _platos
            .Where(p => p.Categoria != null)
            .Select(p => p.Categoria.Nombre)
            .Distinct()
            .OrderBy(c => c)
            .ToList();
        _categorias.AddRange(catList);
    }

    private void SetCategory(string categoria)
    {
        _selectedCategory = categoria;
    }

    private void ScrollToMenu()
    {
        Navigation.NavigateTo("/#seccion-menu");
    }

    private void OnOrderDish(Producto plato)
    {
        Toast.ShowSuccess($"Ha seleccionado: {plato.Nombre}. Puede incluirlo al hacer su reserva de mesa.");
        Navigation.NavigateTo("/reservas/nueva");
    }

    private void OnLikeDish(Producto plato)
    {
        Toast.ShowInfo($"¡Le gusta {plato.Nombre}! Guardado en sus favoritos.");
    }

    private IEnumerable<Producto> FilteredPlatos => _platos.Where(p =>
        (_selectedCategory == "Todos" || (p.Categoria?.Nombre ?? "") == _selectedCategory) &&
        (string.IsNullOrWhiteSpace(_searchTerm) ||
         p.Nombre.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
         (p.Descripcion ?? "").Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
    );
}
