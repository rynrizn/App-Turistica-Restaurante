@page "/"
@using RestauranteTuristicoApp.Models
@using RestauranteTuristicoApp.Services
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ProductoService ProductoService

<PageTitle>Sabor & Tradición | Menú & Cava Tarijeña</PageTitle>

<!-- SECCIÓN HERO / PRESENTACIÓN -->
<div class="pa-6 pa-md-10 mb-8 rounded-xl" 
     style="background: linear-gradient(135deg, rgba(97, 0, 0, 0.92) 0%, rgba(44, 44, 44, 0.94) 100%), url('https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat; color: white; box-shadow: 0 16px 40px rgba(97,0,0,0.25);">
    <MudGrid Class="align-center">
        <MudItem xs="12" md="8">
            <MudChip T="string" Size="Size.Small" Style="background-color: rgba(254,214,91,0.2); color: #fed65b; border: 1px solid #fed65b; font-weight: 600;" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.WineBar" Size="Size.Small" Class="mr-1" /> ALTA GASTRONOMÍA & VINOS DE ALTURA
            </MudChip>
            <MudText Typo="Typo.h2" Class="mb-3" Style="font-family: 'Playfair Display', serif; font-weight: 700; line-height: 1.15;">
                El Sabor de Tarija,<br />
                <span style="color: #fed65b; font-style: italic;">Elevado en Cada Detalle.</span>
            </MudText>
            <MudText Typo="Typo.body1" Class="mb-6" Style="max-width: 600px; color: #f0f1f2; font-size: 1.1rem; line-height: 1.6;">
                Un homenaje a la cocina chapaca patrimonial maridada con los mejores vinos Tannat del Valle de la Concepción. Disfrute como un auténtico sommelier.
            </MudText>
            <div class="d-flex flex-wrap gap-3">
                <MudButton Variant="Variant.Filled" 
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.TableBar"
                           OnClick="@(() => Navigation.NavigateTo("reservas"))"
                           Style="background-color: #fed65b; color: #735c00; font-weight: 700; border-radius: 8px; padding: 12px 28px;">
                    RESERVAR MESA
                </MudButton>
                <MudButton Variant="Variant.Outlined" 
                           Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.RestaurantMenu"
                           OnClick="ScrollToMenu"
                           Style="border-color: white; color: white; font-weight: 600; border-radius: 8px; padding: 12px 24px;">
                    VER CARTA DEL CHEF
                </MudButton>
            </div>
        </MudItem>
        <MudItem xs="12" md="4" Class="d-none d-md-flex justify-end">
            <div class="pa-4 rounded-lg text-center" style="background: rgba(255,255,255,0.1); backdrop-filter: blur(10px); border: 1px solid rgba(254,214,91,0.4); max-width: 280px;">
                <MudText Typo="Typo.h4" Style="color: #fed65b; font-family: 'Playfair Display', serif; font-weight: 700;">1,850 m</MudText>
                <MudText Typo="Typo.caption" Style="color: white; text-transform: uppercase; letter-spacing: 1px;">Altitud de Nuestros Viñedos</MudText>
                <MudDivider Class="my-3" Style="border-color: rgba(254,214,91,0.3);" />
                <MudText Typo="Typo.h5" Style="color: white; font-family: 'Playfair Display', serif; font-weight: 700;">4.9 / 5.0 ★</MudText>
                <MudText Typo="Typo.caption" Style="color: #e1e3e4;">Calificación de Críticos Culinarios</MudText>
            </div>
        </MudItem>
    </MudGrid>
</div>

<!-- FILTROS DE CATEGORÍA -->
<div id="seccion-menu" class="mb-6">
    <div class="d-flex flex-wrap align-center justify-space-between mb-4">
        <div>
            <MudText Typo="Typo.h4" Style="font-family: 'Playfair Display', serif; color: var(--color-primary); font-weight: 700;">
                Carta Gastronómica
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Seleccione una categoría para explorar nuestras especialidades y recomendaciones de maridaje.
            </MudText>
        </div>
        
        <!-- Búsqueda rápida -->
        <MudTextField @bind-Value="_searchTerm" 
                      Placeholder="Buscar plato o vino..." 
                      Variant="Variant.Outlined" 
                      Adornment="Adornment.Start" 
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      AdornmentColor="Color.Primary"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Style="max-width: 280px; background: white; border-radius: 8px;" />
    </div>

    <!-- CHIPS DE CATEGORÍA -->
    <div class="d-flex flex-wrap gap-2 mb-4">
        @foreach (var cat in _categorias)
        {
            var isSelected = _selectedCategory == cat;
            <MudButton Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                       Color="@(isSelected ? Color.Primary : Color.Default)"
                       OnClick="@(() => SetCategory(cat))"
                       Size="Size.Small"
                       Class="@(isSelected ? "sabor-bg-burgundy px-4 py-2" : "px-4 py-2")"
                       Style="border-radius: 20px; font-weight: 600;">
                @cat
            </MudButton>
        }
    </div>
</div>

<!-- GRID DE PLATOS -->
<MudGrid Spacing="4">
    @foreach (var plato in FilteredPlatos)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Class="sabor-card d-flex flex-column" Elevation="2" Style="height: 100%;">
                <div class="sabor-image-container" style="position: relative; height: 220px;">
                    <img src="@(plato.ImagenUrl ?? "https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=800&q=80")" alt="@plato.Nombre" style="width: 100%; height: 100%; object-fit: cover;" />
                    <div style="position: absolute; top: 12px; right: 12px;">
                        <MudChip T="string" Size="Size.Small" Class="sabor-chip-gold">
                            @(plato.Categoria?.Nombre ?? "Especialidad")
                        </MudChip>
                    </div>
                </div>

                <MudCardContent Class="flex-grow-1 pa-4">
                    <div class="d-flex justify-space-between align-start mb-1">
                        <MudText Typo="Typo.h6" Style="font-family: 'Playfair Display', serif; color: var(--color-on-surface); font-weight: 700;">
                            @plato.Nombre
                        </MudText>
                        <MudText Typo="Typo.h6" Style="color: var(--color-primary); font-weight: 700; white-space: nowrap;">
                            Bs. @plato.Precio.ToString("N2")
                        </MudText>
                    </div>

                    <MudText Typo="Typo.caption" Class="d-block mb-2 font-weight-bold" Style="color: var(--color-secondary); text-transform: uppercase;">
                        <MudIcon Icon="@Icons.Material.Filled.WineBar" Size="Size.Small" Class="mr-1" /> Maridaje: Vino Tannat / Moscatel Tarijeño
                    </MudText>

                    <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="line-height: 1.5;">
                        @plato.Descripcion
                    </MudText>
                </MudCardContent>

                <MudCardActions Class="pa-4 pt-0 d-flex justify-space-between align-center">
                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Primary" 
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.AddShoppingCart"
                               OnClick="@(() => OnOrderDish(plato))"
                               Style="border-color: var(--color-primary); border-radius: 6px; font-weight: 600;">
                        Reservar Mesa con este Plato
                    </MudButton>
                    <MudIconButton Icon="@Icons.Material.Filled.FavoriteBorder" 
                                   Color="Color.Default" 
                                   Size="Size.Small"
                                   OnClick="@(() => OnLikeDish(plato))" />
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>

<!-- PIE / SECCIÓN DE INFORMACIÓN COLONIAL -->
<div class="mt-12 pa-8 rounded-xl text-center" style="background-color: #f3f4f5; border: 1px solid #e3beb8;">
    <MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Large" Style="color: #735c00;" Class="mb-2" />
    <MudText Typo="Typo.h5" Style="font-family: 'Playfair Display', serif; color: #610000; font-weight: 700;">
        Gastronomía Patrimonial Tarijeña
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mx-auto mt-2" Style="max-width: 680px;">
        Todos nuestros ingredientes provienen de productores locales del Valle de La Concepción y San Lorenzo. Cocinamos con leña de molle y respetamos los tiempos de cocción de nuestras abuelas.
    </MudText>
</div>

@code {
    private string _searchTerm = "";
    private string _selectedCategory = "Todos";

    private List<Producto> _platos = new();
    private readonly List<string> _categorias = new() { "Todos" };

    protected override async Task OnInitializedAsync()
    {
        _platos = await ProductoService.GetProductosDisponiblesAsync();
        var catList = _platos
            .Where(p => p.Categoria != null)
            .Select(p => p.Categoria.Nombre)
            .Distinct()
            .OrderBy(c => c)
            .ToList();
        _categorias.AddRange(catList);
    }

    private void SetCategory(string categoria)
    {
        _selectedCategory = categoria;
    }

    private void ScrollToMenu()
    {
        Navigation.NavigateTo("/#seccion-menu");
    }

    private void OnOrderDish(Producto plato)
    {
        Snackbar.Add($"Ha seleccionado: {plato.Nombre}. Puede incluirlo al hacer su reserva de mesa.", Severity.Success);
        Navigation.NavigateTo("/reservas/nueva");
    }

    private void OnLikeDish(Producto plato)
    {
        Snackbar.Add($"¡Le gusta {plato.Nombre}! Guardado en sus favoritos.", Severity.Info);
    }

    private IEnumerable<Producto> FilteredPlatos => _platos.Where(p =>
        (_selectedCategory == "Todos" || (p.Categoria?.Nombre ?? "") == _selectedCategory) &&
        (string.IsNullOrWhiteSpace(_searchTerm) ||
         p.Nombre.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
         (p.Descripcion ?? "").Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
    );
}
