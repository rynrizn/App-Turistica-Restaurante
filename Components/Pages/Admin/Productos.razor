@page "/admin/productos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador")]
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using RestauranteTuristicoApp.Models
@using RestauranteTuristicoApp.Services
@inject IDbContextFactory<AppWebContext> DbFactory
@inject ProductoService ProductoService
@inject ToastService Toast
@inject IJSRuntime JS

<PageTitle>Gestión del Menú | Sabor & Tradición</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-5 gap-3">
    <div>
        <h1 class="font-playfair fw-bold mb-1" style="color: var(--sabor-burgundy);">
            Gestión del Menú & Carta Gastronómica
        </h1>
        <p class="text-muted mb-0">
            Administración de platillos, precios, descripciones y disponibilidad.
        </p>
    </div>
    <button type="button" class="btn btn-sabor-burgundy px-4 py-2" @onclick="NuevoProducto">
        <i class="bi bi-plus-lg me-2"></i>NUEVO PRODUCTO
    </button>
</div>

<div class="row g-4">
    <!-- Panel Izquierdo: Buscador y Tabla -->
    <div class="col-12 col-md-8">
        <div class="card sabor-card p-4 border-0 shadow-sm">
            <div class="input-group mb-4">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control border-start-0" placeholder="Buscar platillo por nombre..."
                       @bind="textoBusqueda" @bind:event="oninput" @onkeyup="BuscarProducto" />
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Plato / Especialidad</th>
                            <th>Categoría</th>
                            <th>Precio</th>
                            <th class="text-end">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prod in productos)
                        {
                            var seleccionado = productoSeleccionado?.Id == prod.Id;
                            <tr class="@(seleccionado ? "table-active fw-semibold" : "")"
                                style="cursor: pointer;"
                                @onclick="() => SeleccionarFila(prod)">
                                <td>@prod.Nombre</td>
                                <td><span class="badge bg-light text-dark border">@(prod.Categoria?.Nombre ?? "Menú")</span></td>
                                <td>Bs. @prod.Precio.ToString("N2")</td>
                                <td class="text-end">
                                    <span class="badge @(prod.Disponible == true ? "bg-success" : "bg-danger")">
                                        @(prod.Disponible == true ? "Disponible" : "Agotado")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Panel Derecho: Detalle / Edición -->
    <div class="col-12 col-md-4">
        <div style="position: sticky; top: 80px;">
            @if (_enEdicion && _productoEditando != null)
            {
                <div class="card sabor-card p-4 border-2 shadow" style="border-color: var(--sabor-burgundy) !important;">
                    <h5 class="font-playfair fw-bold mb-3" style="color: var(--sabor-burgundy);">
                        @(_productoEditando.Id == 0 ? "Nuevo Producto" : "Editar Producto")
                    </h5>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Nombre</label>
                        <input type="text" class="form-control" @bind="_productoEditando.Nombre" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Categoría</label>
                        <select class="form-select" @bind="_productoEditando.CategoriaId">
                            @foreach (var c in categorias)
                            {
                                <option value="@c.Id">@c.Nombre</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Precio (Bs.)</label>
                        <input type="number" step="0.5" class="form-control" @bind="_productoEditando.Precio" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">URL Imagen</label>
                        <input type="text" class="form-control" @bind="_productoEditando.ImagenUrl" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Descripción</label>
                        <textarea class="form-control" rows="3" @bind="_productoEditando.Descripcion"></textarea>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="checkDisp" @bind="_productoEditando.Disponible" />
                        <label class="form-check-label" for="checkDisp">
                            Disponible en carta
                        </label>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelarEdicion">
                            Cancelar
                        </button>
                        <button type="button" class="btn btn-sabor-burgundy" @onclick="GuardarProducto">
                            Guardar
                        </button>
                    </div>
                </div>
            }
            else if (productoSeleccionado != null)
            {
                <div class="card sabor-card border-0 shadow-sm overflow-hidden">
                    <img src="@(productoSeleccionado.ImagenUrl ?? "https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=800&q=80")"
                         alt="@productoSeleccionado.Nombre"
                         class="w-100 object-fit-cover" style="height: 200px;" />
                    <div class="card-body p-4">
                        <h5 class="font-playfair fw-bold mb-1">@productoSeleccionado.Nombre</h5>
                        <strong class="d-block mb-3" style="color: var(--sabor-burgundy);">
                            Bs. @productoSeleccionado.Precio.ToString("N2")
                        </strong>
                        <p class="text-muted small mb-4">
                            @productoSeleccionado.Descripcion
                        </p>
                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="EditarProducto">
                                <i class="bi bi-pencil me-1"></i>Editar
                            </button>
                            <button type="button" class="btn btn-sm @(productoSeleccionado.Disponible == true ? "btn-outline-danger" : "btn-outline-success")"
                                    @onclick="ToggleDisponibilidad">
                                @(productoSeleccionado.Disponible == true ? "Agotar" : "Habilitar")
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    Seleccione un producto para ver o editar el detalle.
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<Producto> productos = new();
    private List<Categoria> categorias = new();
    private Producto? productoSeleccionado;
    private int indiceSeleccionado = 0;
    private string textoBusqueda = "";

    private bool _enEdicion = false;
    private Producto? _productoEditando;

    protected override async Task OnInitializedAsync()
    {
        categorias = await ProductoService.GetCategoriasActivasAsync();
        await CargarLista();
    }

    private async Task CargarLista()
    {
        var todos = await ProductoService.GetProductosConCategoriaAsync();
        if (string.IsNullOrWhiteSpace(textoBusqueda))
        {
            productos = todos;
            if (productoSeleccionado == null || !productos.Any(p => p.Id == productoSeleccionado.Id))
            {
                productoSeleccionado = productos.FirstOrDefault();
            }
        }
        else
        {
            productos = todos.Where(p => p.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase)).ToList();
            if (productoSeleccionado == null || !productos.Any(p => p.Id == productoSeleccionado.Id))
            {
                productoSeleccionado = productos.FirstOrDefault();
            }
        }
    }

    private void SeleccionarFila(Producto p)
    {
        productoSeleccionado = p;
        indiceSeleccionado = Math.Max(0, productos.IndexOf(p));
        _enEdicion = false;
    }

    private void NuevoProducto()
    {
        _productoEditando = new Producto
        {
            Disponible = true,
            CategoriaId = categorias.FirstOrDefault()?.Id ?? 1
        };
        _enEdicion = true;
    }

    private void EditarProducto()
    {
        if (productoSeleccionado == null) return;
        _productoEditando = new Producto
        {
            Id = productoSeleccionado.Id,
            Nombre = productoSeleccionado.Nombre,
            Descripcion = productoSeleccionado.Descripcion,
            Precio = productoSeleccionado.Precio,
            ImagenUrl = productoSeleccionado.ImagenUrl,
            Disponible = productoSeleccionado.Disponible,
            CategoriaId = productoSeleccionado.CategoriaId
        };
        _enEdicion = true;
    }

    private void CancelarEdicion()
    {
        _enEdicion = false;
        _productoEditando = null;
    }

    private async Task GuardarProducto()
    {
        if (_productoEditando == null || string.IsNullOrWhiteSpace(_productoEditando.Nombre))
        {
            Toast.ShowWarning("Ingrese un nombre válido para el producto.");
            return;
        }

        bool exito;
        if (_productoEditando.Id == 0)
        {
            exito = await ProductoService.CrearProductoAsync(_productoEditando);
        }
        else
        {
            exito = await ProductoService.ActualizarProductoAsync(_productoEditando);
        }

        if (exito)
        {
            Toast.ShowSuccess("¡Producto guardado correctamente!");
            _enEdicion = false;
            await CargarLista();
        }
        else
        {
            Toast.ShowError("Error al guardar el producto.");
        }
    }

    private async Task ToggleDisponibilidad()
    {
        if (productoSeleccionado == null) return;
        var exito = await ProductoService.ToggleDisponibilidadAsync(productoSeleccionado.Id);
        if (exito)
        {
            Toast.ShowInfo("Estado de disponibilidad actualizado.");
            await CargarLista();
        }
    }

    private async Task BuscarProducto()
    {
        await CargarLista();
    }
}