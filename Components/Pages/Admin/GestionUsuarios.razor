@page "/admin/usuarios"
@attribute [Authorize(Roles = "Administrador")]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using RestauranteTuristicoApp.Models
@using RestauranteTuristicoApp.Services
@inject UsuarioService UsuarioService
@inject ToastService Toast

<PageTitle>Gestión de Usuarios | Sabor & Tradición</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-5 gap-3">
    <div>
        <h1 class="font-playfair fw-bold mb-1" style="color: var(--sabor-burgundy);">
            Gestión de Usuarios
        </h1>
        <p class="text-muted mb-0">
            Administración de personal, clientes y roles de acceso del restaurante.
        </p>
    </div>
    <button type="button" class="btn btn-sabor-burgundy px-4 py-2" @onclick="PrepararNuevoUsuario">
        <i class="bi bi-person-plus-fill me-2"></i>Adicionar Usuario
    </button>
</div>

<div class="card sabor-card p-4 border-0 shadow-sm">
    @if (usuarios == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-danger" role="status"></div>
            <p class="text-muted mt-2">Cargando usuarios activos...</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nombres</th>
                        <th>Apellidos</th>
                        <th>Email</th>
                        <th>Rol</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in usuarios)
                    {
                        <tr>
                            <td><strong>@user.Nombres</strong></td>
                            <td>@user.Apellidos</td>
                            <td>@user.Email</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(user.Rol?.Nombre ?? "Sin Rol")
                                </span>
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary me-1" title="Editar"
                                        @onclick="() => PrepararEdicion(user)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                @if (_confirmDeleteId == user.Id)
                                {
                                    <button type="button" class="btn btn-sm btn-danger fw-bold"
                                            @onclick="() => EliminarLogico(user.Id)">
                                        Confirmar
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => _confirmDeleteId = 0">
                                        X
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar"
                                            @onclick="() => ConfirmarEliminacion(user.Id)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- MODAL BLAZOR PURO PARA NUEVO / EDICIÓN -->
@if (drawerAbierto)
{
    <div class="modal fade show" style="display: block; background: rgba(0, 0, 0, 0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-light">
                    <h5 class="modal-title font-playfair fw-bold" style="color: var(--sabor-burgundy);">
                        @(esEdicion ? "Modificar Empleado/Usuario" : "Nuevo Usuario")
                    </h5>
                    <button type="button" class="btn-close" @onclick="CerrarDrawer"></button>
                </div>

                <EditForm Model="@usuarioEnEdicion" OnValidSubmit="GuardarCambios">
                    <DataAnnotationsValidator />
                    <div class="modal-body p-4">
                        @if (!string.IsNullOrEmpty(mensajeError))
                        {
                            <div class="alert alert-danger small mb-3">@mensajeError</div>
                        }

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Nombres *</label>
                            <input type="text" class="form-control" @bind="usuarioEnEdicion.Nombres" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Apellidos *</label>
                            <input type="text" class="form-control" @bind="usuarioEnEdicion.Apellidos" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Teléfono</label>
                            <input type="tel" class="form-control" @bind="usuarioEnEdicion.Telefono" />
                        </div>

                        @if (!esEdicion)
                        {
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Correo Electrónico *</label>
                                <input type="email" class="form-control" @bind="usuarioEnEdicion.Email" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Contraseña *</label>
                                <input type="password" class="form-control" @bind="passwordInput" required />
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Rol de Usuario *</label>
                            <select class="form-select" @bind="usuarioEnEdicion.RolId">
                                @if (rolesList != null)
                                {
                                    @foreach (var rol in rolesList)
                                    {
                                        <option value="@rol.Id">@rol.Nombre</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CerrarDrawer">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-sabor-burgundy" disabled="@guardando">
                            @(guardando ? "Procesando..." : "Guardar Cambios")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<Usuario>? usuarios;
    private List<Role>? rolesList;
    private Usuario usuarioEnEdicion = new();
    private string passwordInput = string.Empty;

    private bool drawerAbierto = false;
    private bool guardando = false;
    private bool esEdicion = false;
    private string mensajeError = string.Empty;
    private int _confirmDeleteId = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarActivos();
    }

    private async Task CargarActivos()
    {
        usuarios = await UsuarioService.GetUsuariosActivosAsync();
        rolesList = await UsuarioService.GetRolesAsync();
    }

    private void PrepararNuevoUsuario()
    {
        usuarioEnEdicion = new Usuario { RolId = rolesList?.FirstOrDefault()?.Id ?? 3 };
        passwordInput = string.Empty;
        esEdicion = false;
        mensajeError = string.Empty;
        drawerAbierto = true;
    }

    private void PrepararEdicion(Usuario usuarioOriginal)
    {
        usuarioEnEdicion = usuarioOriginal.Clonar();
        esEdicion = true;
        mensajeError = string.Empty;
        drawerAbierto = true;
    }

    private void CerrarDrawer()
    {
        drawerAbierto = false;
    }

    private async Task GuardarCambios()
    {
        mensajeError = string.Empty;
        guardando = true;

        try
        {
            if (esEdicion)
            {
                bool actualizado = await UsuarioService.ActualizarUsuarioAsync(usuarioEnEdicion);
                if (actualizado)
                {
                    Toast.ShowSuccess("Datos actualizados correctamente.");
                    await CargarActivos();
                    CerrarDrawer();
                }
            }
            else
            {
                if (string.IsNullOrWhiteSpace(usuarioEnEdicion.Email) || string.IsNullOrWhiteSpace(passwordInput))
                {
                    mensajeError = "Correo y contraseña son obligatorios al crear.";
                    return;
                }

                bool registrado = await UsuarioService.InsertUsuarioAsync(usuarioEnEdicion, passwordInput);
                if (registrado)
                {
                    Toast.ShowSuccess("Usuario guardado exitosamente.");
                    await CargarActivos();
                    CerrarDrawer();
                }
                else
                {
                    mensajeError = "El correo ya está registrado.";
                }
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private void ConfirmarEliminacion(int id)
    {
        _confirmDeleteId = id;
        Toast.ShowWarning("Haga clic en 'Confirmar' para dar de baja al usuario.");
    }

    private async Task EliminarLogico(int id)
    {
        bool completado = await UsuarioService.DarDeBajaAsync(id);
        if (completado)
        {
            Toast.ShowInfo("Usuario dado de baja.");
            _confirmDeleteId = 0;
            await CargarActivos();
        }
    }
}