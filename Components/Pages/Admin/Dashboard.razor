@*
    Página del dashboard administrativo.
    Muestra indicadores, estadísticas y reportes del restaurante.
*@

@page "/admin/dashboard"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador,Empleado")]
@using RestauranteTuristicoApp.Models
@using RestauranteTuristicoApp.Services
@inject ReporteService ReporteService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Dashboard Administrativo | Sabor & Tradición</PageTitle>

<div class="mb-5">
    <h1 class="font-playfair fw-bold mb-1" style="color: var(--sabor-burgundy);">
        Dashboard Administrativo
    </h1>
    <p class="text-muted mb-0">
        Métricas clave, rendimiento del restaurante y estadísticas operativas del mes.
    </p>
</div>

@if (_cargando || _resumen == null)
{
    <div class="text-center py-5">
        <div class="spinner-border text-danger" role="status"></div>
        <p class="text-muted mt-2">Calculando métricas y reportes...</p>
    </div>
}
else
{
    <!-- TARJETAS DE MÉTRICAS -->
    <div class="row g-4 mb-4">
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card sabor-card h-100 p-4 d-flex flex-row align-items-center justify-content-between border-0 shadow-sm border-start border-4"
                 style="border-left-color: var(--sabor-burgundy) !important;">
                <div>
                    <small class="text-muted text-uppercase fw-bold">Reservas Hoy</small>
                    <h2 class="font-playfair fw-bold mb-0 mt-1" style="color: var(--sabor-burgundy);">
                        @_resumen.ReservasHoy
                    </h2>
                </div>
                <i class="bi bi-calendar-event fs-1 text-danger"></i>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-md-3">
            <div class="card sabor-card h-100 p-4 d-flex flex-row align-items-center justify-content-between border-0 shadow-sm border-start border-4 border-warning">
                <div>
                    <small class="text-muted text-uppercase fw-bold">Pendientes</small>
                    <h2 class="font-playfair fw-bold mb-0 mt-1 text-warning">
                        @_resumen.ReservasPendientes
                    </h2>
                </div>
                <i class="bi bi-hourglass-split fs-1 text-warning"></i>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-md-3">
            <div class="card sabor-card h-100 p-4 d-flex flex-row align-items-center justify-content-between border-0 shadow-sm border-start border-4 border-success">
                <div>
                    <small class="text-muted text-uppercase fw-bold">Completadas Mes</small>
                    <h2 class="font-playfair fw-bold mb-0 mt-1 text-success">
                        @_resumen.ReservasCompletadasMes
                    </h2>
                </div>
                <i class="bi bi-check-circle fs-1 text-success"></i>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-md-3">
            <div class="card sabor-card h-100 p-4 d-flex flex-row align-items-center justify-content-between border-0 shadow-sm border-start border-4"
                 style="border-left-color: #fed65b !important; background-color: #fffcf5;">
                <div>
                    <small class="text-muted text-uppercase fw-bold">Total Facturado</small>
                    <h2 class="font-playfair fw-bold mb-0 mt-1" style="color: #735c00;">
                        Bs. @_resumen.TotalFacturadoMes.ToString("N0")
                    </h2>
                </div>
                <i class="bi bi-cash-stack fs-1" style="color: #735c00;"></i>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- TOP PLATILLOS -->
        <div class="col-12 col-md-5">
            <div class="card sabor-card h-100 p-4 border-0 shadow-sm">
                <h5 class="font-playfair fw-bold mb-3" style="color: var(--sabor-burgundy);">
                    Top Platillos del Mes
                </h5>
                @if (!_resumen.TopPlatillos.Any())
                {
                    <p class="text-muted small">Aún no hay comandas registradas.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Plato</th>
                                    <th>Categoría</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in _resumen.TopPlatillos)
                                {
                                    <tr>
                                        <td><strong>@p.NombreProducto</strong></td>
                                        <td><span class="badge bg-light text-dark border">@p.Categoria</span></td>
                                        <td class="text-end">@p.CantidadTotal uds</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- ÚLTIMAS RESERVAS -->
        <div class="col-12 col-md-7">
            <div class="card sabor-card h-100 p-4 border-0 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="font-playfair fw-bold mb-0" style="color: var(--sabor-burgundy);">
                        Últimas Reservas Registradas
                    </h5>
                    <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-bold" style="color: var(--sabor-burgundy);"
                            @onclick="@(() => Navigation.NavigateTo("gestion/pedidos"))">
                        Ver todas →
                    </button>
                </div>

                @if (!_resumen.UltimasReservas.Any())
                {
                    <p class="text-muted small">Sin reservas.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Código</th>
                                    <th>Cliente</th>
                                    <th>Fecha / Hora</th>
                                    <th class="text-end">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in _resumen.UltimasReservas)
                                {
                                    <tr>
                                        <td><strong>@r.CodigoReserva</strong></td>
                                        <td>@(r.Usuario?.Nombres ?? "Cliente")</td>
                                        <td>@r.FechaReserva.ToString("dd/MM") — @r.HoraReserva.ToString("hh\\:mm")</td>
                                        <td class="text-end">
                                            <span class="badge @GetBadgeClass(r.Estado)">@r.Estado</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private ResumenDashboard? _resumen;
    private bool _cargando = true;

    @* Carga la información del dashboard al iniciar la página. *@
    protected override async Task OnInitializedAsync()
    {
        _cargando = true;
        _resumen = await ReporteService.GetResumenDashboardAsync();
        _cargando = false;
    }

     
    private string GetBadgeClass(string estado) => estado switch
    {
        "Confirmada" => "bg-success",
        "Completada" => "bg-info",
        "Cancelada" => "bg-danger",
        "Pendiente" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}
