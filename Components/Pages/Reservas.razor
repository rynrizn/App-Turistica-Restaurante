@page "/reservas"
@page "/reservas/nueva"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Cliente")]
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using RestauranteTuristicoApp.Models
@using RestauranteTuristicoApp.Services
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ReservaService ReservaService
@inject ProductoService ProductoService
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Reservar Mesa | Sabor & Tradición</PageTitle>

<div class="mb-6">
    <MudText Typo="Typo.h4" Style="font-family: 'Playfair Display', serif; color: var(--color-primary); font-weight: 700;">
        Reservación de Mesa & Cava
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        Personalice su experiencia culinaria en Tarija. Disponibilidad en tiempo real.
    </MudText>
</div>

<MudGrid Spacing="4">
    <!-- COLUMNA DEL STEPPER / FORMULARIO -->
    <MudItem xs="12" md="8">
        <MudCard Class="sabor-card pa-4" Elevation="3">
            <MudTabs @ref="_tabs" Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="pt-2" Color="Color.Primary" ActivePanelIndex="@_currentStep">
                
                <!-- PASO 1: FECHA Y HORA -->
                <MudTabPanel Text="1. Fecha, Hora y Comensales" Icon="@Icons.Material.Filled.CalendarMonth" Disabled="@(_currentStep != 0)">
                    <div class="pt-3">
                        <MudText Typo="Typo.h6" Class="mb-3" Style="font-family: 'Playfair Display', serif; color: #610000;">
                            ¿Cuándo nos visitará?
                        </MudText>
                        
                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="6">
                                <MudDatePicker Label="Fecha de Reserva" @bind-Date="_selectedDate" Variant="Variant.Outlined" 
                                               DateFormat="dd/MM/yyyy" Required="true" MinDate="DateTime.Today" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTimePicker Label="Hora Estimada" @bind-Time="_selectedTime" Variant="Variant.Outlined" Required="true" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudSelect T="int" @bind-Value="_numPersonas" Label="Número de Comensales" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                                    @for (int i = 1; i <= 12; i++)
                                    {
                                        int val = i;
                                        <MudSelectItem Value="@val">@val @(val == 1 ? "Persona" : "Personas")</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudSelect T="string" @bind-Value="_motivoVisita" Label="Motivo / Celebración" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                                    <MudSelectItem Value="@("Almuerzo / Cena Familiar")" />
                                    <MudSelectItem Value="@("Cata de Vinos / Maridaje")" />
                                    <MudSelectItem Value="@("Cumpleaños o Aniversario")" />
                                    <MudSelectItem Value="@("Cena de Negocios")" />
                                </MudSelect>
                            </MudItem>
                        </MudGrid>

                        <div class="d-flex justify-end mt-6">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="sabor-bg-burgundy px-6" 
                                       OnClick="@(() => IrAPaso2())" Style="border-radius: 8px; font-weight: 600;">
                                Siguiente: Seleccionar Mesa →
                            </MudButton>
                        </div>
                    </div>
                </MudTabPanel>

                <!-- PASO 2: AMBIENTE Y MESA + PRE-ORDEN -->
                <MudTabPanel Text="2. Mesa y Platillos" Icon="@Icons.Material.Filled.TableBar" Disabled="@(_currentStep != 1)">
                    <div class="pt-3">
                        <MudText Typo="Typo.h6" Class="mb-3" Style="font-family: 'Playfair Display', serif; color: #610000;">
                            Elija una de las mesas disponibles
                        </MudText>

                        @if (_buscandoMesas)
                        {
                            <div class="text-center py-6">
                                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                                <MudText Class="mt-2">Buscando mesas disponibles...</MudText>
                            </div>
                        }
                        else if (!_mesasDisponibles.Any())
                        {
                            <MudAlert Severity="Severity.Warning" Class="mb-4">
                                No hay mesas disponibles para @_numPersonas personas en esa fecha y hora. Por favor intente otro horario o fecha.
                            </MudAlert>
                        }
                        else
                        {
                            <MudGrid Spacing="3" Class="mb-6">
                                @foreach (var mesa in _mesasDisponibles)
                                {
                                    var seleccionada = _mesaSeleccionada?.Id == mesa.Id;
                                    <MudItem xs="12" sm="6" md="4">
                                        <MudCard Elevation="@(seleccionada ? 6 : 1)" 
                                                 Class="pa-3 text-center cursor-pointer"
                                                 Style="@(seleccionada ? "border: 2px solid #610000; background: #fff8f8;" : "border: 1px solid #e0e0e0;")"
                                                 @onclick="@(() => SelectMesa(mesa))">
                                            <MudIcon Icon="@Icons.Material.Filled.TableBar" Color="Color.Primary" Size="Size.Large" Class="mb-1" />
                                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Mesa #@mesa.NumeroMesa</MudText>
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Capacidad: @mesa.CapacidadPersonas personas</MudText>
                                        </MudCard>
                                    </MudItem>
                                }
                            </MudGrid>
                        }

                        <MudDivider Class="my-4" />

                        <!-- PRE-ORDEN OPCIONAL DE PLATILLOS -->
                        <MudText Typo="Typo.h6" Class="mb-1" Style="font-family: 'Playfair Display', serif; color: #610000;">
                            Pre-orden de Platillos (Opcional)
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                            Puede ordenar sus platos ahora para que estén listos al llegar. Si lo prefiere, ordene directamente en el restaurante.
                        </MudText>

                        <MudGrid Spacing="2" Class="mb-4">
                            @foreach (var prod in _productosMenu)
                            {
                                var cantActual = _preOrden.ContainsKey(prod.Id) ? _preOrden[prod.Id] : 0;
                                <MudItem xs="12" sm="6">
                                    <MudCard Elevation="1" Class="pa-3 d-flex align-center justify-space-between" Style="border: 1px solid #e0e0e0;">
                                        <div>
                                            <MudText Typo="Typo.subtitle2" Class="font-weight-bold">@prod.Nombre</MudText>
                                            <MudText Typo="Typo.caption" Style="color: #610000;">Bs. @prod.Precio.ToString("N2")</MudText>
                                        </div>
                                        <div class="d-flex align-center gap-1">
                                            <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" Color="Color.Default"
                                                           Disabled="@(cantActual == 0)"
                                                           OnClick="@(() => CambiarCantidad(prod.Id, -1))" />
                                            <MudText Typo="Typo.body2" Class="mx-1 font-weight-bold">@cantActual</MudText>
                                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary"
                                                           OnClick="@(() => CambiarCantidad(prod.Id, 1))" />
                                        </div>
                                    </MudCard>
                                </MudItem>
                            }
                        </MudGrid>

                        <MudTextField @bind-Value="_notasEspeciales" 
                                      Label="Notas Especiales / Alergias Alimentarias" 
                                      Variant="Variant.Outlined" 
                                      Lines="2" 
                                      Placeholder="Ej: Aniversario especial, una persona celíaca, mesa con buena iluminación..." />

                        <div class="d-flex justify-space-between mt-6">
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="@(() => NextStep(0))">
                                ← Volver
                            </MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="sabor-bg-burgundy px-6" 
                                       Disabled="@(_mesaSeleccionada == null || _guardandoReserva)"
                                       OnClick="@(() => ConfirmarReserva())" Style="border-radius: 8px; font-weight: 600;">
                                @if (_guardandoReserva)
                                {
                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                    <MudText Class="ms-2">Guardando...</MudText>
                                }
                                else
                                {
                                    <MudText>Confirmar Datos de Mesa →</MudText>
                                }
                            </MudButton>
                        </div>
                    </div>
                </MudTabPanel>

                <!-- PASO 3: CONFIRMACIÓN Y COMPROBANTE -->
                <MudTabPanel Text="3. Confirmación" Icon="@Icons.Material.Filled.CheckCircle" Disabled="@(_currentStep != 2)">
                    <div class="text-center py-6">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Size="Size.Large" Style="color: #735c00; font-size: 4rem;" Class="mb-2" />
                        <MudText Typo="Typo.h5" Style="font-family: 'Playfair Display', serif; color: #610000; font-weight: 700;">
                            ¡Su Mesa Está Reservada!
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">
                            Hemos registrado su reservación con éxito en Tarija.
                        </MudText>

                        <div class="pa-4 rounded-lg mx-auto mb-6 text-left" style="background-color: #f8f9fa; border: 1px solid #e3beb8; max-width: 440px;">
                            <div class="d-flex justify-space-between mb-2">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">CÓDIGO RESERVA:</MudText>
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold" Style="color: #610000;">@_codigoGenerado</MudText>
                            </div>
                            <MudDivider Class="my-2" />
                            <MudGrid Spacing="1">
                                <MudItem xs="6">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">FECHA:</MudText>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">@_selectedDate?.ToString("dd/MM/yyyy")</MudText>
                                </MudItem>
                                <MudItem xs="6">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">HORA:</MudText>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">@_selectedTime?.ToString("hh\\:mm") hrs</MudText>
                                </MudItem>
                                <MudItem xs="6">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">COMENSALES:</MudText>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">@_numPersonas Personas</MudText>
                                </MudItem>
                                <MudItem xs="6">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">MESA:</MudText>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">Mesa #@(_mesaSeleccionada?.NumeroMesa)</MudText>
                                </MudItem>
                            </MudGrid>
                            @if (_preOrden.Any(x => x.Value > 0))
                            {
                                <MudDivider Class="my-2" />
                                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1">PLATILLOS PRE-ORDENADOS:</MudText>
                                @foreach (var pair in _preOrden.Where(p => p.Value > 0))
                                {
                                    var pr = _productosMenu.FirstOrDefault(p => p.Id == pair.Key);
                                    if (pr != null)
                                    {
                                        <MudText Typo="Typo.body2" Class="d-block">
                                            • @pair.Value x @pr.Nombre (Bs. @((pair.Value * pr.Precio).ToString("N2")))
                                        </MudText>
                                    }
                                }
                            }
                        </div>

                        <div class="d-flex justify-center gap-3">
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" 
                                       StartIcon="@Icons.Material.Filled.Download"
                                       OnClick="DownloadTicket"
                                       Style="background-color: #fed65b; color: #735c00; font-weight: 700; border-radius: 8px;">
                                COMPROBANTE LISTO
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" 
                                       OnClick="@(() => Navigation.NavigateTo("mis-reservas"))"
                                       Style="border-color: #610000; border-radius: 8px; font-weight: 600;">
                                VER EN MIS RESERVAS
                            </MudButton>
                        </div>
                    </div>
                </MudTabPanel>

            </MudTabs>
        </MudCard>
    </MudItem>

    <!-- COLUMNA RESUMEN -->
    <MudItem xs="12" md="4">
        <MudCard Class="sabor-card pa-4" Elevation="3">
            <MudText Typo="Typo.h6" Class="mb-3" Style="font-family: 'Playfair Display', serif; color: var(--color-primary); font-weight: 700;">
                Resumen de su Reserva
            </MudText>
            
            <div class="pa-3 mb-4 rounded-lg" style="background-color: rgba(254, 214, 91, 0.12); border: 1px solid #fed65b;">
                <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-1" Style="color: #735c00;">
                    <MudIcon Icon="@Icons.Material.Filled.WineBar" Size="Size.Small" Class="mr-1" /> BENEFICIO SOCIO VIP
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Copa de cortesía de Tannat Aranjuez de bienvenida para usted y sus acompañantes.
                </MudText>
            </div>

            <MudList T="string" ReadOnly="true" Dense="true" Class="pa-0">
                <MudListItem Icon="@Icons.Material.Filled.CalendarToday" IconColor="Color.Primary">
                    <MudText Typo="Typo.body2"><b>Fecha:</b> @_selectedDate?.ToString("dd/MM/yyyy")</MudText>
                </MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.AccessTime" IconColor="Color.Primary">
                    <MudText Typo="Typo.body2"><b>Hora:</b> @_selectedTime?.ToString("hh\\:mm")</MudText>
                </MudListItem>
                <MudListItem Icon="@Icons.Material.Filled.People" IconColor="Color.Primary">
                    <MudText Typo="Typo.body2"><b>Personas:</b> @_numPersonas comensales</MudText>
                </MudListItem>
                @if (_mesaSeleccionada != null)
                {
                    <MudListItem Icon="@Icons.Material.Filled.TableBar" IconColor="Color.Secondary">
                        <MudText Typo="Typo.body2"><b>Mesa:</b> Mesa #@_mesaSeleccionada.NumeroMesa</MudText>
                    </MudListItem>
                }
            </MudList>

            @if (_preOrden.Any(x => x.Value > 0))
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-1 font-weight-bold" Style="color: #610000;">Pre-orden seleccionada:</MudText>
                <ul style="padding-left: 20px; font-size: 0.85rem;">
                    @foreach (var pair in _preOrden.Where(p => p.Value > 0))
                    {
                        var prod = _productosMenu.FirstOrDefault(p => p.Id == pair.Key);
                        if (prod != null)
                        {
                            <li>@pair.Value x @prod.Nombre</li>
                        }
                    }
                </ul>
            }

            <MudDivider Class="my-3" />

            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                ¿Desea explorar más nuestra carta?
            </MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.RestaurantMenu"
                       OnClick="@(() => Navigation.NavigateTo("menu"))"
                       Class="px-0 mt-1" Style="font-weight: 700;">
                Ver Carta Culinaria →
            </MudButton>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private MudTabs? _tabs;
    private int _currentStep = 0;

    private DateTime? _selectedDate = DateTime.Today.AddDays(1);
    private TimeSpan? _selectedTime = new TimeSpan(19, 30, 0);
    private int _numPersonas = 4;
    private string _motivoVisita = "Almuerzo / Cena Familiar";
    private string _notasEspeciales = "";

    private bool _buscandoMesas = false;
    private bool _guardandoReserva = false;
    private List<Mesa> _mesasDisponibles = new();
    private Mesa? _mesaSeleccionada;
    private List<Producto> _productosMenu = new();
    private Dictionary<int, int> _preOrden = new();
    private string _codigoGenerado = "";

    protected override async Task OnInitializedAsync()
    {
        _productosMenu = await ProductoService.GetProductosDisponiblesAsync();
    }

    private async Task IrAPaso2()
    {
        if (_selectedDate == null || _selectedTime == null)
        {
            Snackbar.Add("Seleccione una fecha y hora válidas.", Severity.Warning);
            return;
        }

        _currentStep = 1;
        _buscandoMesas = true;
        _mesaSeleccionada = null;

        var fecha = DateOnly.FromDateTime(_selectedDate.Value);
        var hora = TimeOnly.FromTimeSpan(_selectedTime.Value);

        _mesasDisponibles = await ReservaService.GetMesasDisponiblesAsync(fecha, hora, _numPersonas);
        _buscandoMesas = false;

        if (_mesasDisponibles.Any())
        {
            _mesaSeleccionada = _mesasDisponibles.First();
        }
    }

    private void SelectMesa(Mesa mesa)
    {
        _mesaSeleccionada = mesa;
        Snackbar.Add($"Mesa #{mesa.NumeroMesa} seleccionada", Severity.Info);
    }

    private void CambiarCantidad(int productoId, int delta)
    {
        if (!_preOrden.ContainsKey(productoId)) _preOrden[productoId] = 0;
        _preOrden[productoId] = Math.Max(0, _preOrden[productoId] + delta);
    }

    private async Task ConfirmarReserva()
    {
        if (_mesaSeleccionada == null || _selectedDate == null || _selectedTime == null)
        {
            Snackbar.Add("Debe seleccionar una mesa antes de confirmar.", Severity.Warning);
            return;
        }

        _guardandoReserva = true;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdStr = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!int.TryParse(userIdStr, out int userId))
        {
            Snackbar.Add("Error obteniendo su sesión de usuario. Vuelva a iniciar sesión.", Severity.Error);
            _guardandoReserva = false;
            return;
        }

        var fecha = DateOnly.FromDateTime(_selectedDate.Value);
        var hora = TimeOnly.FromTimeSpan(_selectedTime.Value);

        var preOrdenLista = new List<(int, int, decimal)>();
        foreach (var pair in _preOrden.Where(x => x.Value > 0))
        {
            var p = _productosMenu.FirstOrDefault(x => x.Id == pair.Key);
            if (p != null)
            {
                preOrdenLista.Add((p.Id, pair.Value, p.Precio));
            }
        }

        string obsCompleta = $"{_motivoVisita}. {_notasEspeciales}";

        _codigoGenerado = await ReservaService.CrearReservaAsync(
            userId, fecha, hora, _numPersonas, obsCompleta, _mesaSeleccionada.Id, preOrdenLista);

        _guardandoReserva = false;
        _currentStep = 2;
        Snackbar.Add($"¡Reserva registrada! Código: {_codigoGenerado}", Severity.Success);
    }

    private void NextStep(int stepIndex)
    {
        _currentStep = stepIndex;
    }

    private void DownloadTicket()
    {
        Snackbar.Add($"Comprobante {_codigoGenerado} generado y listo.", Severity.Success);
    }
}
