@page "/reservas"
@page "/reservas/nueva"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Cliente")]
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using RestauranteTuristicoApp.Models
@using RestauranteTuristicoApp.Services
@inject ToastService Toast
@inject NavigationManager Navigation
@inject ReservaService ReservaService
@inject ProductoService ProductoService
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Reservar Mesa | Sabor & Tradición</PageTitle>

<div class="mb-5">
    <h1 class="font-playfair fw-bold" style="color: var(--sabor-burgundy);">
        Reservación de Mesa & Cava
    </h1>
    <p class="text-muted">
        Personalice su experiencia culinaria en Tarija. Disponibilidad en tiempo real.
    </p>
</div>

<div class="row g-4">
    <!-- COLUMNA DEL STEPPER / FORMULARIO -->
    <div class="col-12 col-md-8">
        <div class="card sabor-card border-0 shadow-sm">
            <!-- WIZARD PROGRESS / NAV TABS -->
            <div class="card-header bg-white border-bottom pt-3 pb-0 px-4">
                <ul class="nav nav-tabs card-header-tabs" role="tablist">
                    <li class="nav-item">
                        <button type="button" class="nav-link @(_currentStep == 0 ? "active fw-bold text-dark border-bottom-0" : "text-muted")"
                                disabled="@(_currentStep != 0)">
                            <i class="bi bi-calendar-event me-2"></i>1. Fecha y Comensales
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button" class="nav-link @(_currentStep == 1 ? "active fw-bold text-dark border-bottom-0" : "text-muted")"
                                disabled="@(_currentStep != 1)">
                            <i class="bi bi-table me-2"></i>2. Mesa y Platillos
                        </button>
                    </li>
                    <li class="nav-item">
                        <button type="button" class="nav-link @(_currentStep == 2 ? "active fw-bold text-dark border-bottom-0" : "text-muted")"
                                disabled="@(_currentStep != 2)">
                            <i class="bi bi-check-circle me-2"></i>3. Confirmación
                        </button>
                    </li>
                </ul>
            </div>

            <div class="card-body p-4">
                <!-- PASO 1: FECHA Y HORA -->
                @if (_currentStep == 0)
                {
                    <h5 class="font-playfair fw-bold mb-3" style="color: var(--sabor-burgundy);">
                        ¿Cuándo nos visitará?
                    </h5>

                    <div class="row g-3 mb-4">
                        <div class="col-12 col-sm-6">
                            <label class="form-label fw-semibold">Fecha de Reserva *</label>
                            <input type="date" class="form-control" @bind="_selectedDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="form-label fw-semibold">Hora Estimada *</label>
                            <input type="time" class="form-control" @bind="_selectedTime" />
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="form-label fw-semibold">Número de Comensales *</label>
                            <select class="form-select" @bind="_numPersonas">
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i">@i @(i == 1 ? "Persona" : "Personas")</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="form-label fw-semibold">Motivo / Celebración *</label>
                            <select class="form-select" @bind="_motivoVisita">
                                <option value="Almuerzo / Cena Familiar">Almuerzo / Cena Familiar</option>
                                <option value="Cata de Vinos / Maridaje">Cata de Vinos / Maridaje</option>
                                <option value="Cumpleaños o Aniversario">Cumpleaños o Aniversario</option>
                                <option value="Cena de Negocios">Cena de Negocios</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-sabor-burgundy px-4 py-2" @onclick="IrAPaso2">
                            Siguiente: Seleccionar Mesa <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                    </div>
                }

                <!-- PASO 2: AMBIENTE Y MESA + PRE-ORDEN -->
                @if (_currentStep == 1)
                {
                    <h5 class="font-playfair fw-bold mb-3" style="color: var(--sabor-burgundy);">
                        Elija una de las mesas disponibles
                    </h5>

                    @if (_buscandoMesas)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-danger" role="status"></div>
                            <p class="text-muted mt-2">Buscando mesas disponibles...</p>
                        </div>
                    }
                    else if (!_mesasDisponibles.Any())
                    {
                        <div class="alert alert-warning mb-4">
                            No hay mesas disponibles para @_numPersonas personas en esa fecha y hora. Por favor intente otro horario o fecha.
                        </div>
                    }
                    else
                    {
                        <div class="row g-3 mb-4">
                            @foreach (var mesa in _mesasDisponibles)
                            {
                                var seleccionada = _mesaSeleccionada?.Id == mesa.Id;
                                <div class="col-12 col-sm-6 col-md-4">
                                    <div class="card h-100 p-3 text-center cursor-pointer @(seleccionada ? "border-danger bg-light" : "border")"
                                         style="cursor: pointer; border-width: @(seleccionada ? "2px" : "1px") !important;"
                                         @onclick="() => SelectMesa(mesa)">
                                        <i class="bi bi-table fs-2 mb-1" style="color: var(--sabor-burgundy);"></i>
                                        <h6 class="fw-bold mb-1">Mesa #@mesa.NumeroMesa</h6>
                                        <small class="text-muted">Capacidad: @mesa.CapacidadPersonas personas</small>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <hr class="my-4" />

                    <h5 class="font-playfair fw-bold mb-1" style="color: var(--sabor-burgundy);">
                        Pre-orden de Platillos (Opcional)
                    </h5>
                    <p class="text-muted small mb-3">
                        Puede ordenar sus platos ahora para que estén listos al llegar. Si lo prefiere, ordene directamente en el restaurante.
                    </p>

                    <div class="row g-2 mb-4">
                        @foreach (var prod in _productosMenu)
                        {
                            var cantActual = _preOrden.ContainsKey(prod.Id) ? _preOrden[prod.Id] : 0;
                            <div class="col-12 col-sm-6">
                                <div class="card p-3 d-flex flex-row align-items-center justify-content-between h-100 border">
                                    <div>
                                        <h6 class="fw-bold mb-0">@prod.Nombre</h6>
                                        <small class="fw-bold" style="color: var(--sabor-burgundy);">Bs. @prod.Precio.ToString("N2")</small>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(cantActual == 0)"
                                                @onclick="() => CambiarCantidad(prod.Id, -1)">
                                            <i class="bi bi-dash"></i>
                                        </button>
                                        <span class="fw-bold">@cantActual</span>
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                @onclick="() => CambiarCantidad(prod.Id, 1)">
                                            <i class="bi bi-plus"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Notas Especiales / Alergias Alimentarias</label>
                        <textarea class="form-control" rows="2" @bind="_notasEspeciales"
                                  placeholder="Ej: Aniversario especial, una persona celíaca, mesa con buena iluminación..."></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => NextStep(0)">
                            <i class="bi bi-arrow-left me-2"></i>Volver
                        </button>
                        <button type="button" class="btn btn-sabor-burgundy px-4 py-2"
                                disabled="@(_mesaSeleccionada == null || _guardandoReserva)"
                                @onclick="ConfirmarReserva">
                            @if (_guardandoReserva)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span>Confirmar Datos de Mesa <i class="bi bi-arrow-right ms-2"></i></span>
                            }
                        </button>
                    </div>
                }

                <!-- PASO 3: CONFIRMACIÓN Y COMPROBANTE -->
                @if (_currentStep == 2)
                {
                    <div class="text-center py-4">
                        <i class="bi bi-check-circle-fill fs-1 text-success mb-2 d-inline-block"></i>
                        <h4 class="font-playfair fw-bold" style="color: var(--sabor-burgundy);">
                            ¡Su Mesa Está Reservada!
                        </h4>
                        <p class="text-muted mb-4">
                            Hemos registrado su reservación con éxito en Tarija.
                        </p>

                        <div class="p-4 rounded-3 mx-auto mb-4 text-start bg-light border" style="max-width: 440px;">
                            <div class="d-flex justify-content-between mb-2">
                                <small class="text-muted">CÓDIGO RESERVA:</small>
                                <strong class="fs-6" style="color: var(--sabor-burgundy);">@_codigoGenerado</strong>
                            </div>
                            <hr class="my-2" />
                            <div class="row g-2">
                                <div class="col-6">
                                    <small class="text-muted d-block">FECHA:</small>
                                    <strong>@_selectedDate?.ToString("dd/MM/yyyy")</strong>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">HORA:</small>
                                    <strong>@_selectedTime?.ToString("hh\\:mm") hrs</strong>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">MESA:</small>
                                    <strong>#@(_mesaSeleccionada?.NumeroMesa ?? 0)</strong>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">COMENSALES:</small>
                                    <strong>@_numPersonas Personas</strong>
                                </div>
                            </div>

                            @if (_preOrden.Any(x => x.Value > 0))
                            {
                                <hr class="my-3" />
                                <small class="text-muted fw-bold d-block mb-1">PLATILLOS PRE-ORDENADOS:</small>
                                @foreach (var pair in _preOrden.Where(p => p.Value > 0))
                                {
                                    var pr = _productosMenu.FirstOrDefault(p => p.Id == pair.Key);
                                    if (pr != null)
                                    {
                                        <div class="small text-dark">
                                            • @pair.Value x @pr.Nombre (Bs. @((pair.Value * pr.Precio).ToString("N2")))
                                        </div>
                                    }
                                }
                            }
                        </div>

                        <div class="d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-sabor-gold fw-bold px-4" @onclick="DownloadTicket">
                                <i class="bi bi-download me-2"></i>COMPROBANTE LISTO
                            </button>
                            <button type="button" class="btn btn-outline-danger fw-bold px-4" @onclick="@(() => Navigation.NavigateTo("mis-reservas"))">
                                <i class="bi bi-calendar-check me-2"></i>VER EN MIS RESERVAS
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- COLUMNA RESUMEN -->
    <div class="col-12 col-md-4">
        <div class="card sabor-card p-4 border-0 shadow-sm">
            <h5 class="font-playfair fw-bold mb-3" style="color: var(--sabor-burgundy);">
                Resumen de su Reserva
            </h5>

            <div class="p-3 mb-4 rounded-3" style="background-color: rgba(254, 214, 91, 0.12); border: 1px solid #fed65b;">
                <small class="fw-bold d-block mb-1" style="color: #735c00;">
                    <i class="bi bi-cup-hot-fill me-1"></i> BENEFICIO SOCIO VIP
                </small>
                <small class="text-muted">
                    Copa de cortesía de Tannat Aranjuez de bienvenida para usted y sus acompañantes.
                </small>
            </div>

            <ul class="list-group list-group-flush small mb-3">
                <li class="list-group-item d-flex align-items-center px-0">
                    <i class="bi bi-calendar-event text-danger me-3 fs-5"></i>
                    <div>
                        <strong>Fecha:</strong> @_selectedDate?.ToString("dd/MM/yyyy")
                    </div>
                </li>
                <li class="list-group-item d-flex align-items-center px-0">
                    <i class="bi bi-clock text-danger me-3 fs-5"></i>
                    <div>
                        <strong>Hora:</strong> @_selectedTime?.ToString("hh\\:mm")
                    </div>
                </li>
                <li class="list-group-item d-flex align-items-center px-0">
                    <i class="bi bi-people text-danger me-3 fs-5"></i>
                    <div>
                        <strong>Personas:</strong> @_numPersonas comensales
                    </div>
                </li>
                <li class="list-group-item d-flex align-items-center px-0">
                    <i class="bi bi-tag text-danger me-3 fs-5"></i>
                    <div>
                        <strong>Motivo:</strong> @_motivoVisita
                    </div>
                </li>
            </ul>

            <hr class="my-3" />

            <small class="text-muted d-block mb-2">
                ¿Desea explorar más nuestra carta?
            </small>
            <button type="button" class="btn btn-link p-0 text-decoration-none fw-bold" style="color: var(--sabor-burgundy);"
                    @onclick="@(() => Navigation.NavigateTo("menu"))">
                Ver Carta Culinaria →
            </button>
        </div>
    </div>
</div>

@code {
    private int _currentStep = 0;

    private DateOnly? _selectedDate = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
    private TimeOnly? _selectedTime = new TimeOnly(19, 30);
    private int _numPersonas = 4;
    private string _motivoVisita = "Almuerzo / Cena Familiar";
    private string _notasEspeciales = "";

    private bool _buscandoMesas = false;
    private bool _guardandoReserva = false;
    private List<Mesa> _mesasDisponibles = new();
    private Mesa? _mesaSeleccionada;
    private List<Producto> _productosMenu = new();
    private Dictionary<int, int> _preOrden = new();
    private string _codigoGenerado = "";

    protected override async Task OnInitializedAsync()
    {
        _productosMenu = await ProductoService.GetProductosDisponiblesAsync();
        foreach (var prod in _productosMenu)
        {
            _preOrden[prod.Id] = 0;
        }
    }

    private async Task IrAPaso2()
    {
        if (_selectedDate == null || _selectedTime == null)
        {
            Toast.ShowError("Por favor seleccione una fecha y hora válidas.");
            return;
        }

        _buscandoMesas = true;
        _currentStep = 1;
        _mesaSeleccionada = null;

        var fecha = _selectedDate ?? DateOnly.FromDateTime(DateTime.Today);
        var hora = _selectedTime ?? new TimeOnly(19, 30);

        _mesasDisponibles = await ReservaService.GetMesasDisponiblesAsync(fecha, hora, _numPersonas);
        _buscandoMesas = false;
    }

    private void SelectMesa(Mesa mesa)
    {
        _mesaSeleccionada = mesa;
    }

    private void CambiarCantidad(int prodId, int delta)
    {
        if (_preOrden.ContainsKey(prodId))
        {
            var actual = _preOrden[prodId];
            var nuevo = actual + delta;
            if (nuevo >= 0)
            {
                _preOrden[prodId] = nuevo;
            }
        }
    }

    private async Task ConfirmarReserva()
    {
        if (_mesaSeleccionada == null)
        {
            Toast.ShowWarning("Por favor seleccione una mesa de las disponibles.");
            return;
        }

        _guardandoReserva = true;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdStr = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (!int.TryParse(userIdStr, out int userId))
        {
            Toast.ShowError("Error obteniendo su sesión de usuario. Vuelva a iniciar sesión.");
            _guardandoReserva = false;
            return;
        }

        var fecha = _selectedDate ?? DateOnly.FromDateTime(DateTime.Today);
        var hora = _selectedTime ?? new TimeOnly(19, 30);

        var preOrdenLista = new List<(int, int, decimal)>();
        foreach (var pair in _preOrden.Where(x => x.Value > 0))
        {
            var p = _productosMenu.FirstOrDefault(x => x.Id == pair.Key);
            if (p != null)
            {
                preOrdenLista.Add((p.Id, pair.Value, p.Precio));
            }
        }

        string obsCompleta = $"{_motivoVisita}. {_notasEspeciales}";

        _codigoGenerado = await ReservaService.CrearReservaAsync(
            userId, fecha, hora, _numPersonas, obsCompleta, _mesaSeleccionada.Id, preOrdenLista);

        _guardandoReserva = false;
        _currentStep = 2;
        Toast.ShowSuccess($"¡Reserva registrada! Código: {_codigoGenerado}");
    }

    private void NextStep(int stepIndex)
    {
        _currentStep = stepIndex;
    }

    private void DownloadTicket()
    {
        Toast.ShowSuccess($"Comprobante {_codigoGenerado} generado y listo.");
    }
}
