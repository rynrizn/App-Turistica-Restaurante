@page "/perfil"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using RestauranteTuristicoApp.Models
@using RestauranteTuristicoApp.Services
@inject ToastService Toast
@inject NavigationManager Navigation
@inject ReservaService ReservaService
@inject UsuarioService UsuarioService
@inject ResenaService ResenaService
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Mi Perfil & Historial | Sabor & Tradición</PageTitle>

@if (_cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-danger" role="status"></div>
        <p class="text-muted mt-2">Cargando su perfil...</p>
    </div>
}
else if (_usuario == null)
{
    <div class="alert alert-danger my-4">
        No se pudo obtener la información de su usuario. Intente iniciar sesión nuevamente.
    </div>
}
else
{
    <!-- HEADER RESUMEN DEL USUARIO -->
    <div class="card sabor-card p-4 p-md-5 mb-4 border-0 shadow-sm">
        <div class="row align-items-center">
            <div class="col-12 col-sm-3 col-md-2 text-center mb-3 mb-sm-0">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center fw-bold fs-2"
                     style="width: 86px; height: 86px; background-color: #fed65b; color: #735c00; box-shadow: 0 8px 24px rgba(115, 92, 0, 0.2);">
                    @GetIniciales(_usuario.Nombres, _usuario.Apellidos)
                </div>
            </div>

            <div class="col-12 col-sm-9 col-md-10">
                <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                    <h2 class="font-playfair fw-bold mb-0" style="color: var(--sabor-burgundy);">
                        @_usuario.Nombres @_usuario.Apellidos
                    </h2>
                    <span class="badge sabor-chip-gold px-3 py-1">
                        ★ @(_usuario.Rol?.Nombre?.ToUpper() ?? "CLIENTE") ORO
                    </span>
                </div>
                <p class="text-muted mb-3">
                    @_usuario.Email · Valle de la Concepción, Tarija
                </p>
                <div class="d-flex flex-wrap gap-4 text-muted small">
                    <div>
                        <strong style="color: var(--sabor-burgundy);">@_reservas.Count</strong> Reservas Registradas
                    </div>
                    <div>
                        <strong style="color: var(--sabor-burgundy);">@_reservas.Count(r => r.Estado == "Confirmada" || r.Estado == "Completada")</strong> Visitas Concretadas
                    </div>
                    <div>
                        <strong style="color: var(--sabor-burgundy);">Socio VIP</strong> Desde @DateTime.Now.Year
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PESTAÑAS DE BOOTSTRAP -->
    <ul class="nav nav-tabs mb-4" role="tablist">
        <li class="nav-item">
            <button type="button" class="nav-link @(_tabIndex == 0 ? "active fw-bold text-dark" : "text-muted")"
                    @onclick="() => SetTab(0)">
                <i class="bi bi-calendar-check me-2"></i>Mis Reservaciones (@_reservas.Count)
            </button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(_tabIndex == 1 ? "active fw-bold text-dark" : "text-muted")"
                    @onclick="() => SetTab(1)">
                <i class="bi bi-gear me-2"></i>Configuración del Perfil
            </button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(_tabIndex == 2 ? "active fw-bold text-dark" : "text-muted")"
                    @onclick="() => SetTab(2)">
                <i class="bi bi-heart me-2"></i>Cava & Favoritos
            </button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(_tabIndex == 3 ? "active fw-bold text-dark" : "text-muted")"
                    @onclick="() => SetTab(3)">
                <i class="bi bi-star-fill me-2 text-warning"></i>Mis Reseñas (@_misResenas.Count)
            </button>
        </li>
    </ul>

    <!-- CONTENIDO TAB 0: MIS RESERVACIONES -->
    @if (_tabIndex == 0)
    {
        @if (!_reservas.Any())
        {
            <div class="alert alert-info py-4 text-center">
                Aún no cuenta con historial de reservaciones en nuestro restaurante.
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var res in _reservas)
                {
                    var mesaNum = res.ReservaMesas.FirstOrDefault()?.Mesa?.NumeroMesa.ToString() ?? "N/A";
                    <div class="col-12 col-md-6">
                        <div class="card sabor-card h-100 p-4 border-0 shadow-sm border-start border-4" style="border-left-color: var(--sabor-burgundy) !important;">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="font-playfair fw-bold mb-0">Mesa #@mesaNum</h6>
                                    <small class="text-muted">Código: <strong>@res.CodigoReserva</strong></small>
                                </div>
                                <span class="badge @GetBadgeClass(res.Estado)">
                                    @res.Estado
                                </span>
                            </div>

                            <hr class="my-2" />

                            <p class="mb-1 small">
                                <i class="bi bi-calendar-event me-2 text-danger"></i>
                                <strong>@res.FechaReserva.ToString("dd/MM/yyyy")</strong> a las <strong>@res.HoraReserva.ToString("hh\\:mm")</strong>
                            </p>
                            <p class="mb-1 small">
                                <i class="bi bi-people me-2 text-danger"></i>
                                @res.CantidadPersonas comensales
                            </p>

                            @if (res.Estado == "Pendiente" || res.Estado == "Confirmada")
                            {
                                <div class="d-flex justify-content-end mt-3 pt-2 border-top">
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            @onclick="() => CancelarReserva(res)">
                                        <i class="bi bi-x-circle me-1"></i>Cancelar
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }

    <!-- CONTENIDO TAB 1: CONFIGURACIÓN DEL PERFIL -->
    @if (_tabIndex == 1)
    {
        <div class="card sabor-card p-4 border-0 shadow-sm" style="max-width: 680px;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="font-playfair fw-bold mb-0" style="color: var(--sabor-burgundy);">
                    Información Personal
                </h5>
                @if (!_modoEdicion)
                {
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-3 px-3"
                            @onclick="() => _modoEdicion = true">
                        <i class="bi bi-pencil me-1"></i>Editar Perfil
                    </button>
                }
            </div>

            <div class="row g-3 mb-4">
                <div class="col-12 col-sm-6">
                    <label class="form-label fw-semibold">Nombres</label>
                    <input type="text" class="form-control" @bind="_usuario.Nombres" disabled="@(!_modoEdicion)" />
                </div>
                <div class="col-12 col-sm-6">
                    <label class="form-label fw-semibold">Apellidos</label>
                    <input type="text" class="form-control" @bind="_usuario.Apellidos" disabled="@(!_modoEdicion)" />
                </div>
                <div class="col-12 col-sm-6">
                    <label class="form-label fw-semibold">Correo Electrónico (Solo Lectura)</label>
                    <input type="email" class="form-control" value="@_usuario.Email" disabled />
                </div>
                <div class="col-12 col-sm-6">
                    <label class="form-label fw-semibold">Teléfono / Celular</label>
                    <input type="tel" class="form-control" @bind="_usuario.Telefono" disabled="@(!_modoEdicion)" />
                </div>
            </div>

            @if (_modoEdicion)
            {
                <div class="d-flex justify-content-end gap-2 border-top pt-3">
                    <button type="button" class="btn btn-outline-secondary px-4 py-2" @onclick="CancelarEdicion">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-danger px-4 py-2" @onclick="GuardarCambios">
                        <i class="bi bi-check-lg me-2"></i>Guardar Cambios
                    </button>
                </div>
            }
        </div>
    }

    <!-- CONTENIDO TAB 2: CAVA & FAVORITOS -->
    @if (_tabIndex == 2)
    {
        <div class="card sabor-card p-4 border-0 shadow-sm text-center py-5">
            <i class="bi bi-wine fs-1 text-warning mb-2 d-inline-block"></i>
            <h5 class="font-playfair fw-bold" style="color: var(--sabor-burgundy);">
                Mi Selección de Vinos de Altura
            </h5>
            <p class="text-muted small mx-auto" style="max-width: 500px;">
                Sus vinos y platillos favoritos guardados en la carta aparecerán aquí en sus próximas visitas al restaurante.
            </p>
        </div>
    }

    <!-- CONTENIDO TAB 3: MIS RESEÑAS -->
    @if (_tabIndex == 3)
    {
        <div class="card sabor-card p-4 border-0 shadow-sm mb-4">
            <h5 class="fw-bold mb-3" style="color: var(--sabor-burgundy);">Comparta su Experiencia</h5>
            <div class="mb-3">
                <label class="form-label fw-bold">Puntuación</label>
                <div>
                    @for (int i = 1; i <= 5; i++)
                    {
                        var starVal = i;
                        <button type="button" class="btn btn-link p-0 me-2 text-warning fs-3 text-decoration-none"
                                @onclick="() => _nuevaCalificacion = starVal">
                            <i class="bi @(starVal <= _nuevaCalificacion ? "bi-star-fill" : "bi-star")"></i>
                        </button>
                    }
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Comentario</label>
                <textarea class="form-control" rows="3" placeholder="¿Qué le pareció la comida y la atención?" @bind="_nuevoComentario"></textarea>
            </div>
            <div>
                <button class="btn btn-danger px-4 rounded-3" @onclick="PublicarResena" disabled="@_enviandoResena">
                    @if (_enviandoResena)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    else
                    {
                        <i class="bi bi-send me-2"></i>
                    }
                    Publicar Reseña
                </button>
            </div>
        </div>

        <h5 class="fw-bold mb-3" style="color: var(--sabor-burgundy);">Mis Testimonios Publicados</h5>
        @if (!_misResenas.Any())
        {
            <div class="alert alert-light border text-center py-4">
                Aún no ha escrito ninguna reseña. ¡Nos encantaría conocer su opinión!
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var r in _misResenas)
                {
                    <div class="col-12">
                        <div class="card border-0 shadow-sm p-3 rounded-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="text-warning">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= r.Calificacion)
                                        {
                                            <i class="bi bi-star-fill me-1"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star me-1 text-muted"></i>
                                        }
                                    }
                                </div>
                                <span class="badge @(r.Estado ? "bg-success" : "bg-secondary")">
                                    @(r.Estado ? "Visible en comunidad" : "Oculta por moderación")
                                </span>
                            </div>
                            <p class="mb-1 text-dark fst-italic">"@r.Comentario"</p>
                            <small class="text-muted">Publicada el @r.FechaResena.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                    </div>
                }
            </div>
        }
    }
}

@code {
    private Usuario? _usuario;
    private List<Reserva> _reservas = new();
    private List<Resena> _misResenas = new();
    private bool _cargando = true;
    private int _tabIndex = 0;
    private bool _modoEdicion = false;

    private int _nuevaCalificacion = 5;
    private string _nuevoComentario = "";
    private bool _enviandoResena = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private void SetTab(int index) => _tabIndex = index;

    private async Task CargarDatos()
    {
        _cargando = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var idClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(idClaim, out int uid))
        {
            _usuario = await UsuarioService.GetUsuarioByIdAsync(uid);
            _reservas = await ReservaService.GetReservasByUsuarioAsync(uid);
            _misResenas = await ResenaService.GetResenasPorUsuarioAsync(uid);
        }
        _cargando = false;
    }

    private async Task PublicarResena()
    {
        if (string.IsNullOrWhiteSpace(_nuevoComentario))
        {
            Toast.ShowWarning("Por favor ingrese su comentario para publicar la reseña.");
            return;
        }
        if (_usuario == null) return;

        _enviandoResena = true;
        var nueva = new Resena
        {
            UsuarioId = _usuario.Id,
            Calificacion = _nuevaCalificacion,
            Comentario = _nuevoComentario.Trim(),
            FechaResena = DateTime.Now,
            Estado = true
        };

        bool ok = await ResenaService.CrearResenaAsync(nueva);
        _enviandoResena = false;

        if (ok)
        {
            Toast.ShowSuccess("¡Gracias por compartir su experiencia en Sabor & Tradición!");
            _nuevoComentario = "";
            _nuevaCalificacion = 5;
            _misResenas = await ResenaService.GetResenasPorUsuarioAsync(_usuario.Id);
        }
        else
        {
            Toast.ShowError("No se pudo publicar la reseña. Intente más tarde.");
        }
    }

    private async Task CancelarReserva(Reserva res)
    {
        if (_usuario == null) return;
        var resCancel = await ReservaService.CancelarReservaAsync(res.Id, _usuario.Id);
        if (resCancel.exito)
        {
            Toast.ShowWarning(resCancel.mensaje);
            await CargarDatos();
        }
        else
        {
            Toast.ShowError(resCancel.mensaje);
        }
    }

    private async Task GuardarCambios()
    {
        if (_usuario == null) return;
        var exito = await UsuarioService.ActualizarUsuarioAsync(_usuario);
        if (exito)
        {
            _modoEdicion = false;
            Toast.ShowSuccess("Datos de perfil actualizados exitosamente.");
        }
        else
        {
            Toast.ShowError("Hubo un error al guardar los cambios.");
        }
    }

    private async Task CancelarEdicion()
    {
        _modoEdicion = false;
        await CargarDatos();
    }

    private string GetIniciales(string nombres, string apellidos)
    {
        char n = !string.IsNullOrEmpty(nombres) ? nombres[0] : 'U';
        char a = !string.IsNullOrEmpty(apellidos) ? apellidos[0] : 'S';
        return $"{n}{a}".ToUpper();
    }

    private string GetBadgeClass(string estado) => estado switch
    {
        "Confirmada" => "bg-success",
        "Completada" => "bg-info",
        "Cancelada" => "bg-danger",
        "Pendiente" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}
