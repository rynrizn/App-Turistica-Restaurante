@using Microsoft.EntityFrameworkCore
@using RestauranteTuristicoApp.Models
@inject AppWebContext DbContext
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color: #8B0000; font-weight: bold;">
            Recuperación de Contraseña
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4" Color="Color.Secondary">
            Ingresa el correo electrónico registrado en tu cuenta. Te generaremos una clave temporal de acceso para que puedas ingresar.
        </MudText>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3" Variant="Variant.Filled">@mensajeError</MudAlert>
        }

        @if (claveRestablecida)
        {
            <MudAlert Severity="Severity.Success" Class="mb-3" Variant="Variant.Outlined">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">¡Contraseña Restablecida!</MudText>
                <MudText Typo="Typo.body2">
                    Tu nueva clave temporal es: <strong style="color: #8B0000; font-size: 1.1rem;">@nuevaClaveTemp</strong>
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Cópiala e inicia sesión con ella.
                </MudText>
            </MudAlert>
        }
        else
        {
            <MudTextField @bind-Value="emailInput"
                          Label="Correo Electrónico *"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          Class="mb-2" />
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cerrar">Cerrar</MudButton>
        @if (!claveRestablecida)
        {
            <MudButton Color="Color.Primary" 
                       Variant="Variant.Filled" 
                       OnClick="ProcesarRecuperacion" 
                       Disabled="procesando">
                @if (procesando)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Validando...</span>
                }
                else
                {
                    <span>Restablecer Clave</span>
                }
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] 
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private string emailInput = string.Empty;
    private string mensajeError = string.Empty;
    private string nuevaClaveTemp = string.Empty;
    private bool procesando = false;
    private bool claveRestablecida = false;

    private async Task ProcesarRecuperacion()
    {
        mensajeError = string.Empty;

        if (string.IsNullOrWhiteSpace(emailInput))
        {
            mensajeError = "Por favor, ingresa tu correo electrónico.";
            return;
        }

        procesando = true;
        try
        {
            // 1. Buscar usuario por Email en PostgreSQL
            var usuario = await DbContext.Usuarios.FirstOrDefaultAsync(u => u.Email == emailInput);

            if (usuario == null)
            {
                mensajeError = "No se encontró ninguna cuenta registrada con este correo.";
                return;
            }

            // 2. Generar clave temporal única (Ej. Temp4821!)
            var random = new Random();
            nuevaClaveTemp = $"Temp{random.Next(1000, 9999)}!";

            // 3. Encriptar nueva clave con BCrypt y actualizar BD
            usuario.PasswordHash = BCrypt.Net.BCrypt.HashPassword(nuevaClaveTemp);
            await DbContext.SaveChangesAsync();

            claveRestablecida = true;
            Snackbar.Add("Se ha generado una clave temporal de acceso.", Severity.Success);
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al procesar la solicitud: {ex.Message}";
        }
        finally
        {
            procesando = false;
        }
    }

    private void Cerrar() => MudDialog.Cancel();
}