@page "/gestion/resenas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador,Empleado")]
@using RestauranteTuristicoApp.Models
@using RestauranteTuristicoApp.Services
@inject ResenaService ResenaService
@inject ToastService Toast
@rendermode InteractiveServer

<PageTitle>Moderación de Reseñas | Sabor & Tradición</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: var(--sabor-burgundy);">
                <i class="bi bi-star me-2"></i>Moderación de Reseñas
            </h2>
            <p class="text-muted mb-0">Gestión de testimonios y comentarios publicados por los clientes</p>
        </div>
        <button class="btn btn-outline-secondary rounded-3" @onclick="CargarResenas">
            <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
        </button>
    </div>

    @if (_cargando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-danger" role="status"></div>
            <p class="text-muted mt-2">Cargando listado de reseñas...</p>
        </div>
    }
    else if (!_resenas.Any())
    {
        <div class="alert alert-light border text-center py-5 rounded-4">
            <i class="bi bi-chat-square-dots fs-1 text-muted d-block mb-3"></i>
            <h5>No hay reseñas registradas aún</h5>
            <p class="text-muted mb-0">Los testimonios escritos por los comensales aparecerán en esta sección.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="py-3 px-4">Cliente</th>
                            <th class="py-3">Puntuación</th>
                            <th class="py-3">Comentario</th>
                            <th class="py-3">Fecha</th>
                            <th class="py-3">Estado</th>
                            <th class="py-3 text-end px-4">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var resena in _resenas)
                        {
                            <tr>
                                <td class="px-4 fw-bold">
                                    <i class="bi bi-person-circle me-2 text-muted"></i>
                                    @(resena.Usuario?.NombreCompleto ?? "Cliente #" + resena.UsuarioId)
                                </td>
                                <td>
                                    <div class="text-warning">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= resena.Calificacion)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-muted"></i>
                                            }
                                        }
                                    </div>
                                </td>
                                <td style="max-width: 350px;">
                                    <span class="d-inline-block text-truncate w-100" title="@resena.Comentario">
                                        @resena.Comentario
                                    </span>
                                </td>
                                <td>@resena.FechaResena.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge @(resena.Estado ? "bg-success" : "bg-secondary")">
                                        @(resena.Estado ? "Visible" : "Oculta")
                                    </span>
                                </td>
                                <td class="text-end px-4">
                                    <button class="btn @(resena.Estado ? "btn-outline-danger" : "btn-outline-success") btn-sm rounded-3 px-3"
                                            @onclick="() => ToggleEstado(resena)">
                                        <i class="bi @(resena.Estado ? "bi-eye-slash" : "bi-eye") me-1"></i>
                                        @(resena.Estado ? "Ocultar" : "Mostrar")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<Resena> _resenas = new();
    private bool _cargando = true;

    protected override async Task OnInitializedAsync()
    {
        await CargarResenas();
    }

    private async Task CargarResenas()
    {
        _cargando = true;
        _resenas = await ResenaService.GetTodasResenasAsync();
        _cargando = false;
    }

    private async Task ToggleEstado(Resena resena)
    {
        bool ok = await ResenaService.ToggleEstadoResenaAsync(resena.Id);
        if (ok)
        {
            resena.Estado = !resena.Estado;
            string msj = resena.Estado ? "Reseña visible en la comunidad" : "Reseña ocultada de la comunidad";
            Toast.ShowSuccess(msj);
        }
        else
        {
            Toast.ShowError("No se pudo cambiar el estado de la reseña.");
        }
    }
}
