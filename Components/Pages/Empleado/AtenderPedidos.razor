@page "/gestion/pedidos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Empleado,Administrador")]
@using Microsoft.EntityFrameworkCore
@using RestauranteTuristicoApp.Models
@using RestauranteTuristicoApp.Services
@inject ReservaService ReservaService
@inject ToastService Toast
@rendermode InteractiveServer

<PageTitle>Atención de Reservas y Pedidos | Sabor & Tradición</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-5 gap-3">
    <div>
        <h1 class="font-playfair fw-bold mb-1" style="color: var(--sabor-burgundy);">
            Atención de Reservas & Comandas
        </h1>
        <p class="text-muted mb-0">
            Gestión operativa del salón, recepción de comensales y cobro de cuentas.
        </p>
    </div>

    <div class="d-flex align-items-center gap-2">
        <input type="date" class="form-control" @bind="_fechaFiltro" style="max-width: 200px;" />
        <button type="button" class="btn btn-outline-secondary" @onclick="() => CargarReservas(false)">
            <i class="bi bi-arrow-clockwise me-1"></i>Filtrar
        </button>
        <button type="button" class="btn btn-outline-danger" @onclick="() => CargarReservas(true)">
            Ver Todos
        </button>
    </div>
</div>

@if (_cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-danger" role="status"></div>
        <p class="text-muted mt-2">Cargando comandas y reservas...</p>
    </div>
}
else if (!_reservas.Any())
{
    <div class="alert alert-info py-4 text-center">
        No se encontraron reservas para el criterio o fecha seleccionada.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var res in _reservas)
        {
            var mesaNum = res.ReservaMesas.FirstOrDefault()?.Mesa?.NumeroMesa.ToString() ?? "Sin Mesa";
            var totalPedido = res.DetalleReservas.Sum(d => d.Cantidad * d.PrecioUnitario);
            var estaEnCobro = _reservaEnCobro?.Id == res.Id;

            <div class="col-12 col-md-6">
                <div class="card sabor-card h-100 border-0 shadow-sm border-start border-4" style="border-left-color: var(--sabor-burgundy) !important;">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <h5 class="font-playfair fw-bold mb-0">Mesa #@mesaNum</h5>
                                    <span class="badge bg-light text-dark border">
                                        @res.CantidadPersonas personas
                                    </span>
                                </div>
                                <small class="text-muted">
                                    <strong>@res.Usuario?.Nombres @res.Usuario?.Apellidos</strong> (@res.CodigoReserva)
                                </small>
                            </div>
                            <span class="badge @GetBadgeClass(res.Estado) px-3 py-1">
                                @res.Estado
                            </span>
                        </div>

                        <hr class="my-2" />

                        <div class="my-2 flex-grow-1 small">
                            <p class="mb-1">
                                <i class="bi bi-calendar-event me-2 text-danger"></i>
                                <strong>@res.FechaReserva.ToString("dd/MM/yyyy")</strong> - <strong>@res.HoraReserva.ToString("hh\\:mm") hrs</strong>
                            </p>
                            @if (!string.IsNullOrWhiteSpace(res.Observaciones))
                            {
                                <p class="text-muted fst-italic mb-2">
                                    Obs: @res.Observaciones
                                </p>
                            }

                            @if (res.DetalleReservas.Any())
                            {
                                <div class="p-2 rounded bg-light border mt-2">
                                    <strong class="d-block mb-1" style="color: var(--sabor-burgundy);">Platillos Pre-ordenados:</strong>
                                    @foreach (var det in res.DetalleReservas)
                                    {
                                        <div class="d-flex justify-content-between text-muted">
                                            <span>@det.Cantidad x @det.Producto.Nombre</span>
                                            <span>Bs. @((det.Cantidad * det.PrecioUnitario).ToString("N2"))</span>
                                        </div>
                                    }
                                    <hr class="my-1" />
                                    <div class="d-flex justify-content-between fw-bold text-dark">
                                        <span>Total Comanda:</span>
                                        <span style="color: var(--sabor-burgundy);">Bs. @totalPedido.ToString("N2")</span>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 pt-2 border-top gap-2">
                            <div class="btn-group btn-group-sm">
                                @if (res.Estado == "Pendiente")
                                {
                                    <button type="button" class="btn btn-outline-success" @onclick="@(() => CambiarEstado(res, "Confirmada"))">
                                        <i class="bi bi-check-circle me-1"></i>Confirmar
                                    </button>
                                }
                                @if (res.Estado == "Confirmada" || res.Estado == "Pendiente")
                                {
                                    <button type="button" class="btn btn-outline-danger" @onclick="@(() => CambiarEstado(res, "Cancelada"))">
                                        <i class="bi bi-x-circle me-1"></i>Cancelar
                                    </button>
                                }
                            </div>

                            @if (res.Estado == "Confirmada")
                            {
                                <button type="button" class="btn btn-sm btn-sabor-gold fw-bold px-3" @onclick="() => AbrirModalPago(res)">
                                    <i class="bi bi-cash-stack me-1"></i>COBRAR CUENTA
                                </button>
                            }
                        </div>

                        <!-- PANEL INLINE DE COBRO -->
                        @if (estaEnCobro)
                        {
                            <div class="mt-3 p-3 rounded-3 bg-light border border-warning">
                                <h6 class="fw-bold mb-3" style="color: var(--sabor-burgundy);">
                                    <i class="bi bi-receipt me-2"></i>Facturación y Cobro (Mesa #@mesaNum)
                                </h6>

                                <div class="row g-2 mb-3">
                                    <div class="col-12 col-sm-6">
                                        <label class="form-label small fw-semibold">Forma de Pago</label>
                                        <select class="form-select form-select-sm" @bind="_formaPagoSeleccionada">
                                            @foreach (var fp in _formasPago)
                                            {
                                                <option value="@fp.Id">@fp.Nombre</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12 col-sm-6">
                                        <label class="form-label small fw-semibold">Descuento (Bs.)</label>
                                        <input type="number" step="0.5" class="form-control form-control-sm" @bind="_descuentoCobro" />
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _reservaEnCobro = null">
                                        Cerrar
                                    </button>
                                    <button type="button" class="btn btn-sm btn-success fw-bold"
                                            disabled="@_procesandoPago"
                                            @onclick="() => CompletarPago(res)">
                                        @if (_procesandoPago)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                            <span>Procesando...</span>
                                        }
                                        else
                                        {
                                            <span><i class="bi bi-check-lg me-1"></i>COMPLETAR PAGO</span>
                                        }
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Reserva> _reservas = new();
    private List<FormasPago> _formasPago = new();
    private bool _cargando = true;
    private DateOnly? _fechaFiltro = DateOnly.FromDateTime(DateTime.Today);
    private Reserva? _reservaEnCobro = null;
    private int _formaPagoSeleccionada = 1;
    private decimal _descuentoCobro = 0m;
    private bool _procesandoPago = false;

    protected override async Task OnInitializedAsync()
    {
        _formasPago = await ReservaService.GetFormasPagoAsync();
        if (_formasPago.Any()) _formaPagoSeleccionada = _formasPago.First().Id;
        await CargarReservas(false);
    }

    private async Task CargarReservas(bool limpiarFecha)
    {
        _cargando = true;
        if (limpiarFecha) _fechaFiltro = null;
        var fecha = _fechaFiltro;
        _reservas = await ReservaService.GetTodasReservasAsync(fecha);
        _cargando = false;
    }

    private async Task CambiarEstado(Reserva res, string nuevoEstado)
    {
        var exito = await ReservaService.ActualizarEstadoReservaAsync(res.Id, nuevoEstado, DateTime.Now, DateTime.Now);
        if (exito)
        {
            res.Estado = nuevoEstado;
            Toast.ShowSuccess($"Reserva {res.CodigoReserva} actualizada a {nuevoEstado}");
        }
    }

    private void AbrirModalPago(Reserva res)
    {
        _reservaEnCobro = res;
        _descuentoCobro = 0m;
    }

    private async Task CompletarPago(Reserva res)
    {
        _procesandoPago = true;
        var factura = await ReservaService.GenerarFacturaAsync(res.Id, _formaPagoSeleccionada, _descuentoCobro);
        if (factura != null)
        {
            var pagado = await ReservaService.CompletarPagoAsync(factura.Id);
            if (pagado)
            {
                Toast.ShowSuccess($"¡Pago completado! Factura {factura.NumeroFactura} registrada.");
                _reservaEnCobro = null;
                await CargarReservas(false);
            }
        }
        else if (res.Factura != null)
        {
            var pagado = await ReservaService.CompletarPagoAsync(res.Factura.Id);
            if (pagado)
            {
                Toast.ShowSuccess("¡Pago completado sobre factura existente!");
                _reservaEnCobro = null;
                await CargarReservas(false);
            }
        }
        _procesandoPago = false;
    }

    private string GetBadgeClass(string estado) => estado switch
    {
        "Confirmada" => "bg-success",
        "Completada" => "bg-info",
        "Cancelada" => "bg-danger",
        "Pendiente" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}
