@page "/gestion/mesas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Empleado,Administrador")]
@using Microsoft.EntityFrameworkCore
@using RestauranteTuristicoApp.Models
@using RestauranteTuristicoApp.Services
@inject IDbContextFactory<AppWebContext> DbFactory
@inject ReservaService ReservaService
@inject ToastService Toast
@rendermode InteractiveServer

<PageTitle>Estado y Gestión de Mesas | Sabor & Tradición</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 class="font-playfair fw-bold mb-1" style="color: var(--sabor-burgundy);">
            Gestión y Estado de Mesas
        </h1>
        <p class="text-muted mb-0">
            Control de disponibilidad del salón, terrazas y cavas del restaurante.
        </p>
    </div>
    <button class="btn btn-danger px-4 py-2 rounded-3" @onclick="AbrirModalMesa">
        <i class="bi bi-plus-circle me-2"></i>NUEVA MESA
    </button>
</div>

@if (_mostrarModalMesa)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header bg-light border-0">
                    <h5 class="modal-title fw-bold" style="color: var(--sabor-burgundy);">Registrar Nueva Mesa</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalMesa"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Número de Mesa</label>
                        <input type="number" class="form-control" @bind="_nuevoNumeroMesa" min="1" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Capacidad (Personas)</label>
                        <input type="number" class="form-control" @bind="_nuevaCapacidad" min="1" max="50" />
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CerrarModalMesa">Cancelar</button>
                    <button type="button" class="btn btn-danger px-4" @onclick="GuardarNuevaMesa" disabled="@_guardandoMesa">
                        @if (_guardandoMesa)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Guardar Mesa
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-danger" role="status"></div>
        <p class="text-muted mt-2">Cargando estado de las mesas...</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var mesa in _mesas)
        {
            var reservadaHoy = _mesasConReservaHoy.Contains(mesa.Id);
            <div class="col-12 col-sm-6 col-md-3">
                <div class="card sabor-card h-100 p-4 text-center d-flex flex-column justify-content-between shadow-sm @(reservadaHoy ? "border-warning" : "border")"
                     style="background: @(mesa.Estado == true ? (reservadaHoy ? "#fffdf9" : "#ffffff") : "#f8f9fa"); opacity: @(mesa.Estado == true ? "1" : "0.75");">
                    
                    <div>
                        <i class="bi bi-table fs-1 mb-2 d-inline-block @(mesa.Estado == true ? (reservadaHoy ? "text-warning" : "text-success") : "text-danger")"></i>
                        
                        <h4 class="font-playfair fw-bold mb-1">
                            Mesa #@mesa.NumeroMesa
                        </h4>

                        <p class="text-muted small mb-3">
                            Capacidad: <strong>@mesa.CapacidadPersonas personas</strong>
                        </p>

                        <div class="mb-3">
                            @if (!mesa.Estado == true)
                            {
                                <span class="badge bg-danger">Inhabilitada</span>
                            }
                            else if (reservadaHoy)
                            {
                                <span class="badge bg-warning text-dark">
                                    <i class="bi bi-calendar-event me-1"></i>Reservada Hoy
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle me-1"></i>Disponible
                                </span>
                            }
                        </div>
                    </div>

                    <hr class="my-2" />

                    <div class="d-flex justify-content-center mt-2">
                        <button type="button" class="btn btn-sm @(mesa.Estado == true ? "btn-outline-danger" : "btn-outline-success")"
                                @onclick="() => ToggleEstadoMesa(mesa)">
                            @(mesa.Estado == true ? "Inhabilitar" : "Habilitar")
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Mesa> _mesas = new();
    private HashSet<int> _mesasConReservaHoy = new();
    private bool _cargando = true;

    private bool _mostrarModalMesa = false;
    private int _nuevoNumeroMesa = 1;
    private int _nuevaCapacidad = 4;
    private bool _guardandoMesa = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarMesas();
    }

    private async Task CargarMesas()
    {
        _cargando = true;
        using var db = DbFactory.CreateDbContext();
        _mesas = await db.Mesas.OrderBy(m => m.NumeroMesa).ToListAsync();

        var hoy = DateOnly.FromDateTime(DateTime.Today);
        var resMesas = await db.ReservaMesas
            .Where(rm => rm.Reserva.FechaReserva == hoy && (rm.Reserva.Estado == "Pendiente" || rm.Reserva.Estado == "Confirmada"))
            .Select(rm => rm.MesaId)
            .Distinct()
            .ToListAsync();

        _mesasConReservaHoy = new HashSet<int>(resMesas);
        _cargando = false;
    }

    private async Task ToggleEstadoMesa(Mesa mesa)
    {
        using var db = DbFactory.CreateDbContext();
        var entidad = await db.Mesas.FindAsync(mesa.Id);
        if (entidad != null)
        {
            entidad.Estado = !entidad.Estado;
            await db.SaveChangesAsync();
            mesa.Estado = entidad.Estado;
            Toast.ShowInfo($"Mesa #{mesa.NumeroMesa} ha sido {(mesa.Estado == true ? "habilitada" : "inhabilitada")}.");
        }
    }

    private void AbrirModalMesa()
    {
        _nuevoNumeroMesa = (_mesas.Max(m => (int?)m.NumeroMesa) ?? 0) + 1;
        _nuevaCapacidad = 4;
        _mostrarModalMesa = true;
    }

    private void CerrarModalMesa()
    {
        _mostrarModalMesa = false;
    }

    private async Task GuardarNuevaMesa()
    {
        if (_nuevoNumeroMesa <= 0)
        {
            Toast.ShowWarning("El número de mesa debe ser mayor a 0.");
            return;
        }
        if (_nuevaCapacidad <= 0)
        {
            Toast.ShowWarning("La capacidad de la mesa debe ser de al menos 1 persona.");
            return;
        }

        _guardandoMesa = true;
        var nueva = new Mesa
        {
            NumeroMesa = _nuevoNumeroMesa,
            CapacidadPersonas = _nuevaCapacidad,
            Estado = true
        };

        bool ok = await ReservaService.CrearMesaAsync(nueva);
        _guardandoMesa = false;

        if (ok)
        {
            Toast.ShowSuccess($"¡Mesa #{_nuevoNumeroMesa} (capacidad {_nuevaCapacidad} pers.) agregada con éxito!");
            _mostrarModalMesa = false;
            await CargarMesas();
        }
        else
        {
            Toast.ShowError($"Ya existe una mesa con el número #{_nuevoNumeroMesa}.");
        }
    }
}
