@page "/gestion/mesas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Empleado,Administrador")]
@using Microsoft.EntityFrameworkCore
@using RestauranteTuristicoApp.Models
@using RestauranteTuristicoApp.Services
@inject IDbContextFactory<AppWebContext> DbFactory
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<PageTitle>Estado y Gestión de Mesas | Sabor & Tradición</PageTitle>

<div class="mb-6">
    <MudText Typo="Typo.h4" Style="font-family: 'Playfair Display', serif; color: #610000; font-weight: 700;">
        Gestión y Estado de Mesas
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        Control de disponibilidad del salón, terrazas y cavas del restaurante.
    </MudText>
</div>

@if (_cargando)
{
    <div class="text-center py-12">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Class="mt-3">Cargando estado de las mesas...</MudText>
    </div>
}
else
{
    <MudGrid Spacing="4">
        @foreach (var mesa in _mesas)
        {
            var reservadaHoy = _mesasConReservaHoy.Contains(mesa.Id);
            <MudItem xs="12" sm="6" md="3">
                <MudCard Class="sabor-card pa-4 text-center d-flex flex-column justify-space-between" 
                         Elevation="@(reservadaHoy ? 6 : 2)"
                         Style="@(mesa.Estado == true ? (reservadaHoy ? "border: 2px solid #e06000; background: #fffdf9;" : "border: 1px solid #c8e6c9;") : "border: 1px solid #ffcdd2; opacity: 0.7;")">
                    
                    <div>
                        <MudIcon Icon="@Icons.Material.Filled.TableBar" 
                                 Color="@(mesa.Estado == true ? (reservadaHoy ? Color.Warning : Color.Success) : Color.Error)" 
                                 Size="Size.Large" Class="mb-2" />
                        
                        <MudText Typo="Typo.h5" Style="font-family: 'Playfair Display', serif; font-weight: 700; color: #191c1d;">
                            Mesa #@mesa.NumeroMesa
                        </MudText>

                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                            Capacidad: <b>@mesa.CapacidadPersonas personas</b>
                        </MudText>

                        <div class="mb-3">
                            @if (!mesa.Estado == true)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error">Inhabilitada</MudChip>
                            }
                            else if (reservadaHoy)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.Event">
                                    Reservada Hoy
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">
                                    Disponible
                                </MudChip>
                            }
                        </div>
                    </div>

                    <MudDivider Class="my-2" />

                    <div class="d-flex justify-center mt-2">
                        <MudButton Variant="Variant.Outlined" 
                                   Color="@(mesa.Estado == true ? Color.Error : Color.Success)"
                                   Size="Size.Small"
                                   OnClick="@(() => ToggleEstadoMesa(mesa))">
                            @(mesa.Estado == true ? "Inhabilitar" : "Habilitar")
                        </MudButton>
                    </div>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<Mesa> _mesas = new();
    private HashSet<int> _mesasConReservaHoy = new();
    private bool _cargando = true;

    protected override async Task OnInitializedAsync()
    {
        await CargarMesas();
    }

    private async Task CargarMesas()
    {
        _cargando = true;
        using var db = DbFactory.CreateDbContext();
        _mesas = await db.Mesas.OrderBy(m => m.NumeroMesa).ToListAsync();

        var hoy = DateOnly.FromDateTime(DateTime.Today);
        var resMesas = await db.ReservaMesas
            .Where(rm => rm.Reserva.FechaReserva == hoy && (rm.Reserva.Estado == "Pendiente" || rm.Reserva.Estado == "Confirmada"))
            .Select(rm => rm.MesaId)
            .Distinct()
            .ToListAsync();

        _mesasConReservaHoy = new HashSet<int>(resMesas);
        _cargando = false;
    }

    private async Task ToggleEstadoMesa(Mesa mesa)
    {
        using var db = DbFactory.CreateDbContext();
        var entidad = await db.Mesas.FindAsync(mesa.Id);
        if (entidad != null)
        {
            entidad.Estado = !entidad.Estado;
            await db.SaveChangesAsync();
            mesa.Estado = entidad.Estado;
            Snackbar.Add($"Mesa #{mesa.NumeroMesa} ha sido {(mesa.Estado == true ? "habilitada" : "inhabilitada")}.", Severity.Info);
        }
    }
}
