@page "/menu"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using RestauranteTuristicoApp.Models
@using RestauranteTuristicoApp.Services
@inject ProductoService ProductoService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Menú Gastronómico | Sabor & Tradición</PageTitle>

<div class="mb-6">
    <MudText Typo="Typo.h4" Style="font-family: 'Playfair Display', serif; color: var(--color-primary); font-weight: 700;">
        Nuestra Carta Gastronómica & Cava
    </MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        Descubra los auténticos sabores del Valle de la Concepción, preparados con ingredientes patrimoniales de Tarija.
    </MudText>
</div>

<!-- FILTROS Y BÚSQUEDA -->
<div class="d-flex flex-wrap align-center justify-space-between mb-6">
    <div class="d-flex flex-wrap gap-2 mb-2 mb-md-0">
        @foreach (var cat in _categorias)
        {
            var isSelected = _selectedCategory == cat;
            <MudButton Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                       Color="@(isSelected ? Color.Primary : Color.Default)"
                       OnClick="@(() => SetCategory(cat))"
                       Size="Size.Small"
                       Class="@(isSelected ? "sabor-bg-burgundy px-4 py-2" : "px-4 py-2")"
                       Style="border-radius: 20px; font-weight: 600;">
                @cat
            </MudButton>
        }
    </div>
    <MudTextField @bind-Value="_searchTerm" 
                  Placeholder="Buscar por nombre o descripción..." 
                  Variant="Variant.Outlined" 
                  Adornment="Adornment.Start" 
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  AdornmentColor="Color.Primary"
                  Margin="Margin.Dense"
                  Immediate="true"
                  Style="max-width: 320px; background: white; border-radius: 8px;" />
</div>

@if (_cargando)
{
    <div class="text-center py-12">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Class="mt-3">Cargando menú...</MudText>
    </div>
}
else if (!FilteredProductos.Any())
{
    <MudAlert Severity="Severity.Info" Class="my-6">
        No se encontraron productos para la categoría o búsqueda seleccionada.
    </MudAlert>
}
else
{
    <MudGrid Spacing="4">
        @foreach (var prod in FilteredProductos)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Class="sabor-card d-flex flex-column" Elevation="2" Style="height: 100%;">
                    <div class="sabor-image-container" style="position: relative; height: 220px;">
                        <img src="@(prod.ImagenUrl ?? "https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=800&q=80")" alt="@prod.Nombre" style="width: 100%; height: 100%; object-fit: cover;" />
                        <div style="position: absolute; top: 12px; right: 12px;">
                            <MudChip T="string" Size="Size.Small" Class="sabor-chip-gold">
                                @(prod.Categoria?.Nombre ?? "Menú")
                            </MudChip>
                        </div>
                    </div>

                    <MudCardContent Class="flex-grow-1 pa-4">
                        <div class="d-flex justify-space-between align-start mb-1">
                            <MudText Typo="Typo.h6" Style="font-family: 'Playfair Display', serif; color: var(--color-on-surface); font-weight: 700;">
                                @prod.Nombre
                            </MudText>
                            <MudText Typo="Typo.h6" Style="color: var(--color-primary); font-weight: 700; white-space: nowrap;">
                                Bs. @prod.Precio.ToString("N2")
                            </MudText>
                        </div>

                        <MudText Typo="Typo.caption" Class="d-block mb-2 font-weight-bold" Style="color: var(--color-secondary); text-transform: uppercase;">
                            <MudIcon Icon="@Icons.Material.Filled.WineBar" Size="Size.Small" Class="mr-1" /> Maridaje: Vino Tannat / Moscatel
                        </MudText>

                        <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="line-height: 1.5;">
                            @prod.Descripcion
                        </MudText>
                    </MudCardContent>

                    <MudCardActions Class="pa-4 pt-0 d-flex justify-space-between align-center">
                        <MudButton Variant="Variant.Outlined" 
                                   Color="Color.Primary" 
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.EventAvailable"
                                   OnClick="@(() => OnReservarConPlato(prod))"
                                   Style="border-color: var(--color-primary); border-radius: 6px; font-weight: 600;">
                            Reservar Mesa
                        </MudButton>
                        <MudChip T="string" Size="Size.Small" Color="@(prod.Disponible == true ? Color.Success : Color.Error)">
                            @(prod.Disponible == true ? "Disponible" : "Agotado")
                        </MudChip>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<Producto> _productos = new();
    private readonly List<string> _categorias = new() { "Todos" };
    private string _selectedCategory = "Todos";
    private string _searchTerm = "";
    private bool _cargando = true;

    protected override async Task OnInitializedAsync()
    {
        _cargando = true;
        _productos = await ProductoService.GetProductosDisponiblesAsync();
        var catList = _productos
            .Where(p => p.Categoria != null)
            .Select(p => p.Categoria.Nombre)
            .Distinct()
            .OrderBy(c => c)
            .ToList();
        _categorias.AddRange(catList);
        _cargando = false;
    }

    private void SetCategory(string cat) => _selectedCategory = cat;

    private IEnumerable<Producto> FilteredProductos => _productos.Where(p =>
        (_selectedCategory == "Todos" || (p.Categoria?.Nombre ?? "") == _selectedCategory) &&
        (string.IsNullOrWhiteSpace(_searchTerm) ||
         p.Nombre.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
         (p.Descripcion ?? "").Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
    );

    private void OnReservarConPlato(Producto prod)
    {
        Snackbar.Add($"Ha seleccionado {prod.Nombre}. Agréguelo al confirmar su mesa.", Severity.Success);
        Navigation.NavigateTo("/reservas/nueva");
    }
}
