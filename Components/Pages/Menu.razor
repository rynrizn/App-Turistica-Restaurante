@page "/menu"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using RestauranteTuristicoApp.Models
@using RestauranteTuristicoApp.Services
@inject ProductoService ProductoService
@inject ToastService Toast
@inject NavigationManager Navigation

<PageTitle>Menú Gastronómico | Sabor & Tradición</PageTitle>

<div class="mb-5">
    <h1 class="font-playfair fw-bold" style="color: var(--sabor-burgundy);">
        Nuestra Carta Gastronómica & Cava
    </h1>
    <p class="text-muted">
        Descubra los auténticos sabores del Valle de la Concepción, preparados con ingredientes patrimoniales de Tarija.
    </p>
</div>

<!-- FILTROS Y BÚSQUEDA -->
<div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
    <div class="d-flex flex-wrap gap-2">
        @foreach (var cat in _categorias)
        {
            var isSelected = _selectedCategory == cat;
            <button type="button"
                    class="btn btn-sm rounded-pill px-3 @(isSelected ? "btn-sabor-burgundy" : "btn-outline-secondary")"
                    @onclick="() => SetCategory(cat)">
                @cat
            </button>
        }
    </div>
    <div class="input-group" style="max-width: 320px;">
        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
        <input type="text" class="form-control border-start-0" placeholder="Buscar por nombre o descripción..."
               @bind="_searchTerm" @bind:event="oninput" />
    </div>
</div>

@if (_cargando)
{
    <div class="text-center py-5">
        <div class="spinner-border text-danger" role="status"></div>
        <p class="text-muted mt-2">Cargando carta gastronómica...</p>
    </div>
}
else if (!FilteredProductos.Any())
{
    <div class="text-center py-5 bg-light rounded-4 border">
        <i class="bi bi-search fs-1 text-muted mb-2 d-inline-block"></i>
        <h5 class="font-playfair fw-bold text-muted">No se encontraron productos</h5>
        <p class="text-muted small">Intente seleccionar otra categoría o cambiar el término de búsqueda.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var prod in FilteredProductos)
        {
            <div class="col-12 col-sm-6 col-md-4">
                <div class="card sabor-card h-100 shadow-sm">
                    <div class="sabor-image-container position-relative" style="height: 220px;">
                        <img src="@prod.ImagenUrl" alt="@prod.Nombre" class="w-100 h-100 object-fit-cover" />
                        <span class="badge position-absolute top-0 end-0 m-3 @(prod.Disponible == true ? "bg-success" : "bg-secondary")">
                            @(prod.Disponible == true ? "Disponible" : "Agotado")
                        </span>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-baseline mb-2">
                            <span class="badge bg-light text-dark border small">@(prod.Categoria?.Nombre ?? "Tradicional")</span>
                            <span class="fw-bold fs-5" style="color: var(--sabor-burgundy);">@prod.Precio.ToString("N2") Bs</span>
                        </div>
                        <h5 class="card-title font-playfair fw-bold mb-2">@prod.Nombre</h5>
                        <p class="card-text text-muted small flex-grow-1">@prod.Descripcion</p>
                    </div>
                    <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between align-items-center pb-3">
                        <button type="button" class="btn btn-sm btn-outline-danger px-3"
                                @onclick="() => OnReservarConPlato(prod)">
                            <i class="bi bi-calendar-check me-1"></i> Reservar Mesa
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Producto> _productos = new();
    private readonly List<string> _categorias = new() { "Todos" };
    private string _selectedCategory = "Todos";
    private string _searchTerm = "";
    private bool _cargando = true;

    protected override async Task OnInitializedAsync()
    {
        _cargando = true;
        _productos = await ProductoService.GetProductosDisponiblesAsync();
        var catList = _productos
            .Where(p => p.Categoria != null)
            .Select(p => p.Categoria.Nombre)
            .Distinct()
            .OrderBy(c => c)
            .ToList();
        _categorias.AddRange(catList);
        _cargando = false;
    }

    private void SetCategory(string cat) => _selectedCategory = cat;

    private IEnumerable<Producto> FilteredProductos => _productos.Where(p =>
        (_selectedCategory == "Todos" || (p.Categoria?.Nombre ?? "") == _selectedCategory) &&
        (string.IsNullOrWhiteSpace(_searchTerm) ||
         p.Nombre.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
         (p.Descripcion ?? "").Contains(_searchTerm, StringComparison.OrdinalIgnoreCase))
    );

    private void OnReservarConPlato(Producto prod)
    {
        Toast.ShowSuccess($"Ha seleccionado {prod.Nombre}. Agréguelo al confirmar su mesa.");
        Navigation.NavigateTo("/reservas");
    }
}
