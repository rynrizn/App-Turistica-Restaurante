@page "/login"
@layout RestauranteTuristicoApp.Components.Layout.AuthLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using Microsoft.EntityFrameworkCore
@using RestauranteTuristicoApp.Models
@using RestauranteTuristicoApp.Services
@inject AppWebContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject ToastService Toast
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="card sabor-auth-card border-0 shadow-lg">
    <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
            <i class="bi bi-cup-hot-fill fs-1 text-warning"></i>
            <h2 class="font-playfair fw-bold mt-2 mb-1" style="color: var(--sabor-burgundy);">
                Iniciar Sesión
            </h2>
            <p class="text-muted small">Bienvenido a Sabor & Tradición</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2"></i>
                <div>@errorMessage</div>
            </div>
        }

        <div class="form-floating mb-3">
            <input type="email" class="form-control" id="floatingEmail" placeholder="correo@ejemplo.com" @bind="email" />
            <label for="floatingEmail"><i class="bi bi-envelope me-2"></i>Correo Electrónico</label>
        </div>

        <div class="form-floating mb-2">
            <input type="password" class="form-control" id="floatingPassword" placeholder="Contraseña" @bind="password" />
            <label for="floatingPassword"><i class="bi bi-lock me-2"></i>Contraseña</label>
        </div>

        <!-- ENLACE ¿OLVIDASTE TU CONTRASEÑA? -->
        <div class="d-flex justify-content-end mb-4">
            <button type="button" class="btn btn-link btn-sm p-0 text-decoration-underline" style="color: var(--sabor-burgundy);" @onclick="AbrirModalRecuperacion">
                ¿Olvidaste tu contraseña?
            </button>
        </div>

        <button type="button" class="btn btn-sabor-burgundy btn-lg w-100 mb-3" @onclick="ProcesarLogin">
            Ingresar
        </button>

        <div class="text-center">
            <button type="button" class="btn btn-link text-decoration-none small" style="color: var(--sabor-on-surface-variant);" @onclick="IrARegistro">
                ¿No tienes cuenta? <strong style="color: var(--sabor-burgundy);">Regístrate aquí</strong>
            </button>
        </div>
    </div>
</div>

<!-- MODAL INLINE DE RECUPERACIÓN DE CONTRASEÑA -->
<div class="modal fade" id="modalRecuperarPassword" tabindex="-1" aria-labelledby="modalRecuperarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title font-playfair fw-bold" id="modalRecuperarLabel" style="color: var(--sabor-burgundy);">
                    <i class="bi bi-key-fill me-2"></i>Recuperar Contraseña
                </h5>
                <button type="button" class="btn-close" @onclick="CerrarModalRecuperacion" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted small mb-3">
                    Ingresa el correo electrónico asociado a tu cuenta. Si está registrado, te enviaremos instrucciones y un enlace de recuperación.
                </p>
                <div class="form-floating">
                    <input type="email" class="form-control" id="recoverEmail" placeholder="correo@ejemplo.com" @bind="recoverEmail" />
                    <label for="recoverEmail"><i class="bi bi-envelope me-2"></i>Correo electrónico</label>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary" @onclick="CerrarModalRecuperacion">
                    Cancelar
                </button>
                <button type="button" class="btn btn-sabor-burgundy" @onclick="EnviarRecuperacion">
                    Enviar Instrucciones
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private string errorMessage = string.Empty;
    private string recoverEmail = string.Empty;

    private async Task ProcesarLogin()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Por favor, ingresa tu correo y contraseña.";
            return;
        }

        var usuario = await DbContext.Usuarios
            .Include(u => u.Rol)
            .FirstOrDefaultAsync(u => u.Email == email);

        if (usuario != null && !usuario.Estado)
        {
            errorMessage = "Su cuenta se encuentra inactiva. Contacte con administración.";
            return;
        }

        if (usuario != null && BCrypt.Net.BCrypt.Verify(password, usuario.PasswordHash))
        {
            var customProvider = (CustomAuthStateProvider)AuthStateProvider;
            
            string nombreCompleto = $"{usuario.Nombres} {usuario.Apellidos}";
            customProvider.MarkUserAsAuthenticated(usuario.Id, usuario.Email, nombreCompleto, usuario.Rol?.Nombre ?? "Cliente");

            Toast.ShowSuccess($"¡Bienvenido {usuario.Nombres}!");
            NavigationManager.NavigateTo("/");
        }
        else
        {
            errorMessage = "Credenciales incorrectas.";
        }
    }

    private void IrARegistro()
    {
        NavigationManager.NavigateTo("/registro");
    }

    private async Task AbrirModalRecuperacion()
    {
        recoverEmail = string.Empty;
        await JS.InvokeVoidAsync("showModal", "modalRecuperarPassword");
    }

    private async Task CerrarModalRecuperacion()
    {
        await JS.InvokeVoidAsync("hideModal", "modalRecuperarPassword");
    }

    private async Task EnviarRecuperacion()
    {
        if (string.IsNullOrWhiteSpace(recoverEmail))
        {
            Toast.ShowWarning("Por favor, ingresa un correo válido.");
            return;
        }

        // Lógica de recuperación
        await JS.InvokeVoidAsync("hideModal", "modalRecuperarPassword");
        Toast.ShowSuccess("Si el correo se encuentra registrado, te hemos enviado un mensaje con instrucciones.");
        recoverEmail = string.Empty;
    }
}